<UserControl x:Class="OpcUa.UI.Views.OpcUaDataAcqReadEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             d:DesignHeight="350" d:DesignWidth="800"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="OpcUa DataAcq Read"
                               Image="pack://application:,,,/OpcUa.StepPlugin.UI;component/Resources/Icons/opcua_data_acq_read.png"
                               ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Task Name:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding TaskName, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Samples To Read:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                         Text="{Binding SamplesToRead, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="序号波形变量:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                         Text="{Binding ResultVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                          Content="将数据追加保存到 CSV 文件"
                          IsChecked="{Binding SaveToFile}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="CSV File Path:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                    IsEnabled="{Binding SaveToFile}"
                    ScriptText="{Binding CsvFilePath, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Grid.Row="5" Text="逐点记录 JSON 变量:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="RecordsJsonVariableBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                         Text="{Binding RecordsJsonVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="6" Text="健康 JSON 变量:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="HealthVariableBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                         Text="{Binding HealthVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="SamplingTimeHint" Grid.Row="7" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="OPC UA 轮询不是等间隔硬件采样。兼容波形横轴仅为记录序号（sample）；真实源/服务器时间、主机接收 UTC、单调时间及质量请使用逐点记录 JSON 或 CSV。非 Good 数据会标记为 NaN 并报告错误，不作为有效测量值。"/>
                <TextBlock Grid.Row="8" Text="消费/导出总期限(ms):" VerticalAlignment="Center" Margin="0,8,8,0"/>
                <TextBox x:Name="ConsumptionTimeoutBox" Grid.Row="8" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0"
                         Text="{Binding TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="排队、转换及 CSV 导出共用此期限；超时后实际导出仍保有消费门，不能视为导出已取消。"/>
            </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
