<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Version>1.0.19</Version>
	<TargetFramework>net8.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>OpcUa.StepPlugin</AssemblyName>
	<RootNamespace>OpcUa</RootNamespace>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<OutputPath>..\..\..\xTestPlatform\xTestPlatform\bin\$(Configuration)\$(TargetFramework)\win-x64\Plugins\OpcUa\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="MessagePack" />
	<PackageReference Include="xTestPlatform.StepEditor.SDK" />
	<PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" />
  </ItemGroup>

</Project>
