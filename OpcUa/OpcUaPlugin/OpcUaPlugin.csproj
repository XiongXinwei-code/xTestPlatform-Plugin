<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Version>1.0.14</Version>
	<TargetFramework>net8.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>OpcUa.StepPlugin</AssemblyName>
	<RootNamespace>OpcUa</RootNamespace>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<OutputPath>..\..\..\xTestPlatform\xTestPlatform\bin\$(Configuration)\$(TargetFramework)\win-x64\Plugins\OpcUa\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="MessagePack" Version="3.1.7" />
	<PackageReference Include="xTestPlatform.StepEditor.SDK" Version="1.2.1" />
	<PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.374.126" />
  </ItemGroup>

</Project>
