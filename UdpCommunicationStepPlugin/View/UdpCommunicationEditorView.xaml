<UserControl x:Class="UdpCommunicationStepPlugin.View.UdpCommunicationEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:setting="clr-namespace:UdpCommunicationStepPlugin.Setting;assembly=UdpCommunication.StepPlugin">
  <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
    <syncfusion:TabItemExt Header="UDP 通信">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <TextBlock Text="远程主机"/><TextBox Text="{Binding Setting.RemoteHost, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" LostFocus="Save_OnLostFocus"/>
        <TextBlock Margin="0,10,0,0" Text="远程端口"/><TextBox Text="{Binding Setting.RemotePort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" LostFocus="Save_OnLostFocus"/>
        <TextBlock Margin="0,10,0,0" Text="本地端口（0 为自动）"/><TextBox Text="{Binding Setting.LocalPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" LostFocus="Save_OnLostFocus"/>
        <TextBlock Margin="0,10,0,0" Text="执行模式"/><ComboBox SelectedValue="{Binding Setting.OperationMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="{x:Static setting:UdpOperationMode.SendOnly}"/><ComboBoxItem Content="{x:Static setting:UdpOperationMode.SendAndWaitForResponse}"/></ComboBox>
        <TextBlock Margin="0,10,0,0" Text="数据格式"/><ComboBox SelectedValue="{Binding Setting.DataFormat, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="{x:Static setting:UdpDataFormat.Utf8Text}"/><ComboBoxItem Content="{x:Static setting:UdpDataFormat.Hex}"/></ComboBox>
        <TextBlock Margin="0,10,0,0" Text="发送数据"/><TextBox AcceptsReturn="True" Height="70" Text="{Binding Setting.Payload, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" LostFocus="Save_OnLostFocus"/>
        <TextBlock Margin="0,10,0,0" Text="响应超时 (ms)"/><TextBox Text="{Binding Setting.ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" LostFocus="Save_OnLostFocus"/>
        <TextBlock Margin="0,10,0,0" Text="响应校验"/><ComboBox SelectedValue="{Binding Setting.ResponseMatchMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="{x:Static setting:UdpResponseMatchMode.AnyResponse}"/><ComboBoxItem Content="{x:Static setting:UdpResponseMatchMode.Exact}"/><ComboBoxItem Content="{x:Static setting:UdpResponseMatchMode.Contains}"/></ComboBox>
        <TextBlock Margin="0,10,0,0" Text="期望响应"/><TextBox Text="{Binding Setting.ExpectedResponse, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" LostFocus="Save_OnLostFocus"/>
        <TextBlock Margin="0,10,0,0" Text="响应变量名"/><TextBox Text="{Binding Setting.ResponseVariableName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" LostFocus="Save_OnLostFocus"/>
      </StackPanel></ScrollViewer>
    </syncfusion:TabItemExt>
  </syncfusion:TabControlExt>
</UserControl>
