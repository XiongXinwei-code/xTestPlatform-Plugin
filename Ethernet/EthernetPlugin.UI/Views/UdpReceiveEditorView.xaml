<UserControl x:Class="Ethernet.UI.Views.UdpReceiveEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             mc:Ignorable="d" d:DesignHeight="320" d:DesignWidth="600">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="UDP Receive"
                               Image="pack://application:,,,/Ethernet.StepPlugin.UI;component/Resources/Icons/ethernet.png"
                               ImageHeight="20" ImageWidth="20">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="LocalPort:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <syncfusion:IntegerTextBox Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                    Value="{Binding LocalPort, Mode=TwoWay}" MinValue="0" MaxValue="65535"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="BindMode:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          SelectedIndex="{Binding BindModeIndex}">
                    <ComboBoxItem Content="AnyInterface"/>
                    <ComboBoxItem Content="LocalPort"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="ExpectedLength:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <syncfusion:IntegerTextBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                    Value="{Binding ExpectedLength, Mode=TwoWay}" MinValue="0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Timeout (ms):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <syncfusion:IntegerTextBox Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                    Value="{Binding TimeoutMs, Mode=TwoWay}" MinValue="1"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Encoding:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          SelectedIndex="{Binding EncodingIndex}">
                    <ComboBoxItem Content="Hex"/>
                    <ComboBoxItem Content="Utf8"/>
                    <ComboBoxItem Content="Ascii"/>
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="ResultVariable:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                         Text="{Binding ResultVariable, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="EnableLog:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding EnableLog}" Margin="0,0,0,8"/>
            </Grid>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
