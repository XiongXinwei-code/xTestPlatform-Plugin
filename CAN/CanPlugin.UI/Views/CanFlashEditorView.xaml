<UserControl x:Class="CAN.UI.Views.CanFlashEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">

        <!-- 页签一：连接与固件 -->
        <syncfusion:TabItemExt Header="连接与固件"
                               Image="pack://application:,,,/CAN.StepPlugin.UI;component/Resources/Icons/can.png"
                               ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="连接名称:" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding ConnectionName, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="请求 ID (TX):" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding TxId, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="响应 ID (RX):" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding RxId, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="响应超时 (ms):" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                         Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>

                <Separator Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,12"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="固件文件:" Style="{StaticResource LabelStyle}"/>
                <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <expr:ExpressionTextBox Grid.Column="0"
                        ScriptText="{Binding FilePath, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Grid.Column="1" Content="浏览..." Width="70" Margin="8,0,0,0" Click="OnBrowseFile"/>
                </Grid>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="文件格式:" Style="{StaticResource LabelStyle}"/>
                <ComboBox Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          SelectedIndex="{Binding FormatIndex}">
                    <ComboBoxItem Content="自动识别（按扩展名）"/>
                    <ComboBoxItem Content="Intel HEX"/>
                    <ComboBoxItem Content="Motorola S-Record"/>
                    <ComboBoxItem Content="原始二进制 BIN"/>
                </ComboBox>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="基地址:" Style="{StaticResource LabelStyle}"
                           Visibility="{Binding IsBinaryFormat, Converter={StaticResource BoolToVis}}"/>
                <expr:ExpressionTextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"
                    Visibility="{Binding IsBinaryFormat, Converter={StaticResource BoolToVis}}"
                    ScriptText="{Binding BaseAddress, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Separator Grid.Row="8" Grid.ColumnSpan="2" Margin="0,8,0,12"/>

                <StackPanel Grid.Row="9" Grid.ColumnSpan="2">
                    <TextBlock Text="固件分析" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="分析固件" Width="100" Click="OnAnalyzeFirmware"
                                IsEnabled="{Binding CanAnalyze}"/>
                        <Button Content="应用建议的地址长度格式" Margin="8,0,0,0" Padding="10,0"
                                Click="OnApplySuggestion"
                                Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SuggestedAlfid, StringFormat=建议值 {0}}" Foreground="Gray"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding AnalysisMessage}" Style="{StaticResource HintStyle}"/>

                    <ListBox ItemsSource="{Binding AnalysisSegments}" MaxHeight="160" Margin="0,0,0,8"
                             FontFamily="Consolas"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Style="{StaticResource HintStyle}"
                               Text="建议值依据固件地址范围与最大数据段长度推算出最小可行字节数，实际取值仍须符合 ECU 刷写规范。"/>
                    <TextBlock Style="{StaticResource HintStyle}"
                               Text="本步骤不切换诊断会话、不执行安全访问，请在前置步骤中使用 UDS_DiagSession 与 UDS_SecurityAccess 完成。"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>

        <!-- 页签二：映射与填充 -->
        <syncfusion:TabItemExt Header="映射与填充"
                               Image="pack://application:,,,/CAN.StepPlugin.UI;component/Resources/Icons/can.png"
                               ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="使用映射范围:" Style="{StaticResource LabelStyle}"/>
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding UseMappedRange}"
                          VerticalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HintStyle}"
                           Text="启用后，将固件映射为一个连续区间。地址空洞以填充字节补齐，擦除、0x34、传输和 CRC 都使用该完整区间；适用于 ZLG 文件下载中的“映射地址/映射结束地址/填充字节”配置。"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="映射起始地址:" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                    IsEnabled="{Binding UseMappedRange}"
                    ScriptText="{Binding MappedStartAddress, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="映射结束地址 (含):" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                    IsEnabled="{Binding UseMappedRange}"
                    ScriptText="{Binding MappedEndAddress, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="空洞填充字节:" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                    IsEnabled="{Binding UseMappedRange}"
                    ScriptText="{Binding GapFillByte, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource HintStyle}"
                           Text="示例：映射起始地址 &quot;0x02000000&quot;，映射结束地址 &quot;0x0237FFFF&quot;，填充字节 &quot;0x00&quot;。映射范围必须完整覆盖固件中的所有数据段。"/>
            </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>

        <!-- 页签三：擦除与下载 -->
        <syncfusion:TabItemExt Header="擦除与下载">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="ECU 刷写规范预设" FontWeight="Bold" Margin="0,16,0,8"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="选择预设:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200" ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"/>
                        <Button Content="应用" Width="60" Margin="8,0,0,0" Click="OnApplyPreset"
                                IsEnabled="{Binding HasSelectedPreset}"/>
                        <Button Content="删除" Width="60" Margin="8,0,0,0" Click="OnDeletePreset"
                                IsEnabled="{Binding HasSelectedPreset}"/>
                        <Button Content="保存为预设..." Padding="10,0" Margin="8,0,0,0" Click="OnSavePreset"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                               Text="预设保存本页的擦除、下载与校验参数，便于在多个序列中复用同一 ECU 的刷写规范；不包含固件路径与连接信息。"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="下载前擦除:" Style="{StaticResource LabelStyle}"/>
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding EraseBeforeDownload}"
                          VerticalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="擦除例程 ID:" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                    IsEnabled="{Binding EraseBeforeDownload}"
                    ScriptText="{Binding EraseRoutineId, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="擦除超时 (ms):" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                         IsEnabled="{Binding EraseBeforeDownload}"
                         Text="{Binding EraseTimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>

                <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,12"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="地址长度格式:" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding AddressAndLengthFormatId, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="数据格式标识:" Style="{StaticResource LabelStyle}"/>
                <expr:ExpressionTextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding DataFormatId, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="单块最大字节:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                    <TextBox Width="200" HorizontalAlignment="Left"
                             Text="{Binding MaxBlockSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                               Text="实际取值不会超过 ECU 在请求下载响应中允许的块长度；设为 0 表示不额外限制，完全采用 ECU 返回值。"/>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="块重试次数:" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="7" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                         Text="{Binding BlockRetryCount, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="块间延时 (ms):" Style="{StaticResource LabelStyle}"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                    <TextBox Width="200" HorizontalAlignment="Left"
                             Text="{Binding InterBlockDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                               Text="用于适配处理速度较慢的 Bootloader，通常保持 0 即可。"/>
                </StackPanel>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="擦除携带地址和长度:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Grid.Row="11" Grid.Column="1" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding EraseWithAddressAndLength}"
                              IsEnabled="{Binding EraseBeforeDownload}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                               Text="勾选时发送 31 01 &lt;RID&gt; &lt;ALFID&gt; &lt;地址&gt; &lt;长度&gt;；对应 ZLG 的“带参数擦除”。启用映射范围时强制带参数，未启用映射时可取消勾选以发送无参数擦除例程。"/>
                </StackPanel>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="下载前延时 (ms):" Style="{StaticResource LabelStyle}"/>
                <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,0,0,8">
                    <TextBox Width="200" HorizontalAlignment="Left"
                             Text="{Binding PreDownloadDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                               Text="在执行本步骤的擦除与下载前等待。APP 需等待 FlashDriver 激活时，可设置为 500 ms。"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>

        <!-- 页签四：校验与输出 -->
        <syncfusion:TabItemExt Header="校验与输出">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="校验方式:" Style="{StaticResource LabelStyle}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          SelectedIndex="{Binding CheckModeIndex}">
                    <ComboBoxItem Content="不校验"/>
                    <ComboBoxItem Content="CRC32"/>
                    <ComboBoxItem Content="字节累加和"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="校验例程 ID:" Style="{StaticResource LabelStyle}"
                           Visibility="{Binding IsCheckEnabled, Converter={StaticResource BoolToVis}}"/>
                <expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                    Visibility="{Binding IsCheckEnabled, Converter={StaticResource BoolToVis}}"
                    ScriptText="{Binding CheckRoutineId, Mode=TwoWay}" ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,12"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="进度变量:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                    <TextBox Width="200" HorizontalAlignment="Left"
                             Text="{Binding ProgressVariable, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                               Text="烧录过程中写入 0~100 的整数百分比，留空则不写入。"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="结果变量:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                    <TextBox Width="200" HorizontalAlignment="Left"
                             Text="{Binding ResultVariable, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                               Text="烧录完成后写入实际传输的总字节数，留空则不写入。"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="输出日志:" Style="{StaticResource LabelStyle}"/>
                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding EnableLog}"
                          VerticalAlignment="Center" Margin="0,0,0,8"/>
            </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>

    </syncfusion:TabControlExt>
</UserControl>
