<UserControl x:Class="CAN.UI.Views.CanopenSdoReadEditorView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			 xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			 xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
			 syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
			 mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
	<!-- CANopen SDO 读取步骤编辑器：通过 SDO 上传读取对象字典条目 -->
	<syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
		<syncfusion:TabItemExt Header="CANopen SDO Read"
							   Image="pack://application:,,,/CAN.StepPlugin.UI;component/Resources/Icons/can.png"
							   ImageHeight="20" ImageWidth="20">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
			<Grid Margin="16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 连接名称：需与前序 CAN_Open 步骤中的连接名称一致 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ConnectionName:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
					ScriptText="{Binding ConnectionName, Mode=TwoWay}" ExpectedResultType="String"
					SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
					EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- EDS/DCF 文件：仅用于编辑时选择对象，运行时不读取 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="EDS 文件:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBox Text="{Binding EdsFilePath, UpdateSourceTrigger=LostFocus}"/>
					<Button Grid.Column="1" Content="浏览..." Width="70" Margin="8,0,0,0" Click="OnBrowseEds"/>
				</Grid>
                <!-- EDS 对象：选中后自动填入 Index、SubIndex 和数据类型 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="EDS 对象:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
					<ComboBox ItemsSource="{Binding EdsObjects}" SelectedItem="{Binding SelectedEdsObject, Mode=TwoWay}" DisplayMemberPath="Display" IsTextSearchEnabled="True" TextSearch.TextPath="Display"/>
					<TextBlock Text="{Binding EdsStatus}" Foreground="Gray" Margin="0,4,0,0"/>
				</StackPanel>

                <!-- 目标节点 ID（1~127） -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Node ID:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
					ScriptText="{Binding NodeId, Mode=TwoWay}" ExpectedResultType="Object"
					SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
					EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- 对象字典索引（0x0000~0xFFFF） -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Index:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
					ScriptText="{Binding Index, Mode=TwoWay}" ExpectedResultType="Object"
					SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
					EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- 对象字典子索引（0~255） -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="SubIndex:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
					ScriptText="{Binding SubIndex, Mode=TwoWay}" ExpectedResultType="Object"
					SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
					EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- 数据类型：选项顺序必须与 CanopenDataType 枚举一致 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Data Type:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="6" Grid.Column="1" SelectedIndex="{Binding DataType, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <ComboBoxItem Content="Boolean"/>
                    <ComboBoxItem Content="Integer8"/>
                    <ComboBoxItem Content="Integer16"/>
                    <ComboBoxItem Content="Integer32"/>
                    <ComboBoxItem Content="Integer64"/>
                    <ComboBoxItem Content="Unsigned8"/>
                    <ComboBoxItem Content="Unsigned16"/>
                    <ComboBoxItem Content="Unsigned32"/>
                    <ComboBoxItem Content="Unsigned64"/>
                    <ComboBoxItem Content="Real32"/>
                    <ComboBoxItem Content="Real64"/>
                    <ComboBoxItem Content="VisibleString"/>
                    <ComboBoxItem Content="OctetString"/>
                </ComboBox>

                <!-- 传输方式：Auto 由数据长度自动选择快速/分段，Block 使用块传输 -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Transfer Mode:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="7" Grid.Column="1" SelectedIndex="{Binding TransferMode, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <ComboBoxItem Content="Auto（快速/分段）"/>
                    <ComboBoxItem Content="Block（块传输）"/>
                </ComboBox>

                <!-- 每帧 SDO 响应超时（毫秒），超时步骤返回 Error -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Timeout (ms):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <!-- 结果变量：用户已声明的变量路径，读取值写入该变量；留空则不写入 -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Result Variable:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ResultVariable, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>

            </Grid>
			</ScrollViewer>
		</syncfusion:TabItemExt>
	</syncfusion:TabControlExt>
</UserControl>
