<UserControl x:Class="CAN.UI.Views.CanOpenEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
             xmlns:local="clr-namespace:CAN.UI.Converters"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:EnumToIntConverter x:Key="EnumToIntConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="CAN Open"
                                           Image="pack://application:,,,/CAN.StepPlugin.UI;component/Resources/Icons/can_open.png"
                                           ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ConnectionName:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding ConnectionName, Mode=TwoWay}"
                    ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Channel:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                    ScriptText="{Binding Channel, Mode=TwoWay}"
                    ExpectedResultType="String"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <expr:ExpressionTextBox.ToolTip>
                        <TextBlock>
                            通道标识，格式取决于 AdapterType：<LineBreak/>
                            • NI（NI-XNET）：接口名 CAN&lt;编号&gt;，如 CAN1（编号从 1 开始）<LineBreak/>
                            • PEAK（PCAN-Basic）：PCAN_USBBUS&lt;编号&gt;，如 PCAN_USBBUS1（也可简写为 1~16）<LineBreak/>
                            • Vector：全局通道索引，如 0、1<LineBreak/>
                            • Kvaser / TOSUN：通道索引，如 0、1<LineBreak/>
                            • ZLG：&lt;设备类型&gt;/&lt;设备索引&gt;/&lt;通道索引&gt;，如 USBCAN2/0/0、USBCANFD-200U/0/1<LineBreak/>
                            &#160;&#160;PCI / PCIe 示例：PCI5010U/0/0、PCIe9120/0/1、PCIE-CANFD-200U/0/1<LineBreak/>
                            &#160;&#160;SDK 全部型号名称及连接配置见 ZLG Hardware 页；枚举存在不代表当前包或本机驱动支持。<LineBreak/>
                            &#160;&#160;型号不区分大小写，支持 SDK 的 ZCAN_* 名称；设备索引和通道索引从 0 开始。<LineBreak/>
                            &#160;&#160;PCIe CAN FD 型号仲裁段采样点为 80%，5 Mbps 数据段为 75%，其他标准数据段为 80%。<LineBreak/>
                            &#160;&#160;PCI5010U / PCI5020U 使用驱动标准波特率，仲裁段采样点由驱动决定，不应用目标采样点。
                        </TextBlock>
                    </expr:ExpressionTextBox.ToolTip>
                </expr:ExpressionTextBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="AdapterType:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          SelectedIndex="{Binding AdapterType, Converter={StaticResource EnumToIntConverter}}">
                    <ComboBoxItem Content="NI"/>
                    <ComboBoxItem Content="PEAK"/>
                    <ComboBoxItem Content="Vector"/>
                    <ComboBoxItem Content="ZLG"/>
                    <ComboBoxItem Content="Kvaser"/>
                    <ComboBoxItem Content="TOSUN"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="BaudRate:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          IsEditable="True"
                          Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="125000"/>
                    <ComboBoxItem Content="250000"/>
                    <ComboBoxItem Content="500000"/>
                    <ComboBoxItem Content="1000000"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Protocol:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          SelectedIndex="{Binding Protocol, Converter={StaticResource EnumToIntConverter}}">
                    <ComboBoxItem Content="Classic"/>
                    <ComboBoxItem Content="CAN FD"/>
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="DataBitRate (数据段):" VerticalAlignment="Center" Margin="0,0,8,8"
                           Visibility="{Binding ShowDataBitRate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          IsEditable="True"
                          Text="{Binding DataBitRate, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding ShowDataBitRate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBoxItem Content="2000000"/>
                    <ComboBoxItem Content="4000000"/>
                    <ComboBoxItem Content="5000000"/>
                    <ComboBoxItem Content="8000000"/>
                </ComboBox>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="接收缓冲区(帧数):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <syncfusion:IntegerTextBox Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                    Value="{Binding RxQueueSize, Mode=TwoWay}" MinValue="1"/>

                <GroupBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Header="总线参数" Margin="0,8,0,0">
                    <Grid Margin="12,10,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="终端电阻:" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="使能设备内置 120 Ω 终端电阻"
                                  IsChecked="{Binding EnableTermination, Mode=TwoWay}" Margin="0,0,0,10"
                                  ToolTip="需要硬件及厂商驱动支持软件终端电阻；不支持时请取消勾选并外接 120 Ω 电阻。"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="仲裁段采样点 (Nominal):" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="7.5" Maximum="97.5" TickFrequency="0.5"
                                    IsSnapToTickEnabled="True" Value="{Binding ArbitrationSamplePoint, Mode=TwoWay}"/>
                            <TextBox Grid.Column="1" Margin="12,0,6,0" VerticalContentAlignment="Center"
                                     Text="{Binding ArbitrationSamplePoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="数据段采样点 (Data):" VerticalAlignment="Center" Margin="0,0,8,10"
                                   Visibility="{Binding ShowDataSamplePoint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                              Visibility="{Binding ShowDataSamplePoint, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="7.5" Maximum="97.5" TickFrequency="0.5"
                                    IsSnapToTickEnabled="True" Value="{Binding DataSamplePoint, Mode=TwoWay}"/>
                            <TextBox Grid.Column="1" Margin="12,0,6,0" VerticalContentAlignment="Center"
                                     Text="{Binding DataSamplePoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="#FFF5F7FA"
                                BorderBrush="#FFD9DEE7" BorderThickness="1" CornerRadius="4" Padding="10">
                            <TextBlock Foreground="#FF5F6368" TextWrapping="Wrap"
                                       Text="只配置目标百分比，插件会按所选适配器转换为驱动位时序；实际采样点会受设备时钟和驱动能力限制。标称比特率采样点作用于经典 CAN 和 CAN FD 仲裁段；CAN FD 数据比特率使用单独的数据段采样点。"/>
                        </Border>
                    </Grid>
                </GroupBox>
                <TextBlock Grid.Row="8" Grid.Column="0" Text="打开总超时 (ms):" VerticalAlignment="Center" Margin="0,12,8,8"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,12,0,8">
                    <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="包含等待旧连接收尾、登记排队与本次打开；超时不会强制释放仍在执行的原生调用。"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>
        <syncfusion:TabItemExt Header="ZLG Hardware" Visibility="{Binding IsZlg, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16">
                    <TextBlock Text="SDK hardware catalog" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="Hardware filter (Regex)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ZlgHardwareFilterEditor" Width="330" Text="{Binding ZlgHardwareFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="不区分大小写。例如 USB、^CANFD.*TCP 或 USB|PCIE。保留当前已选型号；清空显示全部。筛选不会修改 Channel。"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ZlgHardwareFilterError}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,8">
                        <ComboBox x:Name="ZlgHardwareSelector" Width="330" ItemsSource="{Binding FilteredZlgDevices}" DisplayMemberPath="Display" SelectedItem="{Binding ZlgDeviceToApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="选择后自动更新 Channel；如需保留动态 Channel 表达式，请直接编辑 Channel。"/>
                        <TextBlock Text="Device index" Margin="12,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Width="70" Text="{Binding ZlgDeviceIndexToApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Channel index" Margin="12,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Width="70" Text="{Binding ZlgChannelIndexToApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" VerticalContentAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ZlgConfigurationHint}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="DimGray"/>
                    <GroupBox x:Name="ZlgNetworkGroup" Header="Network connection" Visibility="{Binding ShowZlgNetwork, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                        <StackPanel Margin="12">
                            <TextBlock Text="PC TCP role (UDP ignores role)"/>
                            <ComboBox Width="220" HorizontalAlignment="Left" SelectedIndex="{Binding ZlgNetworkWorkMode}">
                                <ComboBoxItem Content="Client (0)"/><ComboBoxItem Content="Server (1)"/>
                            </ComboBox>
                            <TextBlock Text="Remote IPv4 address (expression)" Margin="0,8,0,3"/>
                            <expr:ExpressionTextBox x:Name="ZlgRemoteAddressEditor" ScriptText="{Binding ZlgRemoteAddress, Mode=TwoWay}" ExpectedResultType="String"
                                SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <TextBlock Text="Remote work port" Margin="0,8,0,3"/>
                            <TextBox x:Name="ZlgRemotePortEditor" Width="200" HorizontalAlignment="Left" Text="{Binding ZlgRemotePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Local port" Margin="0,8,0,3"/>
                            <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding ZlgLocalPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ZlgFileGroup" Header="CANFDCOM configuration file" Visibility="{Binding ShowZlgFile, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                        <StackPanel Margin="12">
                            <TextBlock Text="Vendor configuration file path (expression)" Margin="0,8,0,3"/>
                            <expr:ExpressionTextBox ScriptText="{Binding ZlgConfigurationPath, Mode=TwoWay}" ExpectedResultType="String"
                                SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ZlgCloudGroup" Header="Cloud connection" Visibility="{Binding ShowZlgCloud, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="12">
                            <TextBlock Text="Password is an expression. Prefer a protected variable; inline literals are saved in the sequence. Both server names are required to avoid inheriting another login endpoint." TextWrapping="Wrap"/>
                            <TextBlock Text="User name (expression)" Margin="0,8,0,3"/>
                            <expr:ExpressionTextBox ScriptText="{Binding ZlgCloudUserName, Mode=TwoWay}" ExpectedResultType="String"
                                SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <TextBlock Text="Password (expression)" Margin="0,8,0,3"/>
                            <expr:ExpressionTextBox ScriptText="{Binding ZlgCloudPassword, Mode=TwoWay}" ExpectedResultType="String"
                                SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <TextBlock Text="HTTP server (expression)" Margin="0,8,0,3"/>
                            <expr:ExpressionTextBox ScriptText="{Binding ZlgCloudHttpServer, Mode=TwoWay}" ExpectedResultType="String"
                                SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <TextBlock Text="HTTP port" Margin="0,8,0,3"/>
                            <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding ZlgCloudHttpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Authentication server (expression)" Margin="0,8,0,3"/>
                            <expr:ExpressionTextBox ScriptText="{Binding ZlgCloudAuthServer, Mode=TwoWay}" ExpectedResultType="String"
                                SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <TextBlock Text="Authentication port" Margin="0,8,0,3"/>
                            <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding ZlgCloudAuthPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
