<UserControl x:Class="CAN.UI.Views.CanopenWaitHeartbeatEditorView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			 xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			 xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
			 syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
			 mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
	<!-- CANopen 心跳等待步骤编辑器：等待节点心跳并校验 NMT 状态 -->
	<syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
		<syncfusion:TabItemExt Header="CANopen Heartbeat"
							   Image="pack://application:,,,/CAN.StepPlugin.UI;component/Resources/Icons/can.png"
							   ImageHeight="20" ImageWidth="20">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
			<Grid Margin="16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 连接名称：需与前序 CAN_Open 步骤中的连接名称一致 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ConnectionName:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
					ScriptText="{Binding ConnectionName, Mode=TwoWay}" ExpectedResultType="String"
					SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
					EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- 目标节点 ID（1~127），监听 COB-ID 0x700 + NodeId -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Node ID:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
					ScriptText="{Binding NodeId, Mode=TwoWay}" ExpectedResultType="Object"
					SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
					EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- 期望状态：Any 表示收到任意心跳即通过 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Expected State:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding ExpectedState, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="BootUp"/>
                    <ComboBoxItem Content="Stopped"/>
                    <ComboBoxItem Content="Operational"/>
                    <ComboBoxItem Content="PreOperational"/>
                </ComboBox>

                <!-- 等待超时（毫秒），超时未收到期望状态时步骤返回 Error -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Timeout (ms):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <!-- 状态变量：用户已声明的 string 变量路径，留空则不写入 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="State Variable:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StateVariable, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>

            </Grid>
			</ScrollViewer>
		</syncfusion:TabItemExt>
	</syncfusion:TabControlExt>
</UserControl>
