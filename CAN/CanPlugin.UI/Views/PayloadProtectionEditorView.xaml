<UserControl x:Class="CAN.UI.Views.PayloadProtectionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CAN.Models;assembly=CAN.StepPlugin"
             xmlns:local="clr-namespace:CAN.UI.Converters"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
             xmlns:views="clr-namespace:CAN.UI.Views">
    <UserControl.Resources>
        <local:EnumToIntConverter x:Key="EnumToIntConverter"/>
        <local:CanCrcSummaryConverter x:Key="CrcSummaryConverter"/>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="WriteOnlyText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="WriteOnlyInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="WriteOnlyChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="StartOffsetLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="写入起始字节:"/>
            <Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Text" Value="字段起始字节:"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EndOffsetLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="写入结束字节（含）:"/>
            <Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Text" Value="字段结束字节（含）:"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="字节偏移从 0 开始，包含结束字节。先写 RC 与启用的显式 Data ID 字段，再计算 CRC；其余业务位保留原值。"/>
            <Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Text" Value="字节偏移从 0 开始，包含结束字节。RC 读取载荷值；CRC 按配置计算期望值，不改写原始报文。DBC 读取步骤另会比较接收 CRC。"/></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style></TextBlock>
        <GroupBox Header="RC 滚动计数器" Margin="0,4,0,12">
            <StackPanel Margin="12">
                <CheckBox x:Name="RcEnabledCheckBox" Content="启用 RC" IsChecked="{Binding RcEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <Grid IsEnabled="{Binding RcEnabled}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource StartOffsetLabel}"/>
                    <TextBox x:Name="RcStartByteBox" Grid.Column="1" Text="{Binding RcStartByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource EndOffsetLabel}"/>
                    <TextBox x:Name="RcEndByteBox" Grid.Row="1" Grid.Column="1" Text="{Binding RcEndByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <TextBlock Grid.Row="2" Text="字节序:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding RcByteOrder, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                        <ComboBoxItem Content="小端（低字节在前）"/><ComboBoxItem Content="大端（高字节在前）"/>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="首帧 Counter（十进制）:" Style="{StaticResource WriteOnlyText}"/>
                    <StackPanel x:Name="RcFirstCounterPanel" Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                            <DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></StackPanel.Style>
                        <TextBox x:Name="RcInitialValueBox" Text="{Binding RcInitialValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource WriteOnlyInput}"
                                 ToolTip="首帧直接使用此值，提交后才按增量推进。Profile 2 也可以从 0 起步；数值须在计数上下限内。"/>
                        <Button x:Name="RcFirstZeroButton" Content="设为 0" Tag="0" Width="52" Margin="8,0,0,6" Click="OnSetFirstCounter" ToolTip="只设置首帧 Counter 为 0，不改变上下限与增量。"/>
                        <Button x:Name="RcFirstOneButton" Content="设为 1" Tag="1" Width="52" Margin="8,0,0,6" Click="OnSetFirstCounter" ToolTip="只设置首帧 Counter 为 1，不改变上下限与增量。"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="最小值（十进制）:" Style="{StaticResource WriteOnlyText}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RcMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource WriteOnlyInput}"/>
                    <TextBlock Grid.Row="5" Text="最大值（十进制）:" Style="{StaticResource WriteOnlyText}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RcMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource WriteOnlyInput}"/>
                    <TextBlock Grid.Row="6" Text="每次增量（可为负）:" Style="{StaticResource WriteOnlyText}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding RcStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource WriteOnlyInput}"/>
                    <TextBlock Grid.Row="7" Text="超出上下限的处理:" Style="{StaticResource WriteOnlyText}"/>
                    <ComboBox Grid.Row="7" Grid.Column="1" SelectedIndex="{Binding RcOverflow, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}" Style="{StaticResource WriteOnlyChoice}">
                        <ComboBoxItem Content="循环（保留跨界余数）"/><ComboBoxItem Content="保持在边界值"/><ComboBoxItem Content="下次发送报错"/>
                    </ComboBox>
                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,6,0,6">
                        <CheckBox x:Name="RcUseBitFieldCheckBox" Content="RC 使用单字节内位域（保留同字节其他位）" IsChecked="{Binding RcUseBitField, Mode=TwoWay}" Margin="0,0,0,8"/>
                        <Grid IsEnabled="{Binding RcUseBitField}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="位起点（0=最低位）:"/>
                            <TextBox x:Name="RcBitOffsetBox" Grid.Column="1" Text="{Binding RcBitOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            <TextBlock Grid.Row="1" Text="位宽（同一字节内）:"/>
                            <TextBox x:Name="RcBitLengthBox" Grid.Row="1" Grid.Column="1" Text="{Binding RcBitLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        </Grid>
                        <TextBlock Text="位域模式要求起止字节相同。Profile 1/2 使用 4 位 Counter，起点为 0 或 4；相邻业务位不会被清零。例如 Byte1 高四位为业务值 A、低四位为 RC，则发送 A0、A1…AF；这是位域组合，不是 Data ID 与 RC 相加。" TextWrapping="Wrap" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="完整字节模式的 RC 占 1～4 字节；位域模式只改所选位。按进入驱动提交的尝试推进，提交失败或取消后不回滚；排队期间取消不消耗计数。" TextWrapping="Wrap" Foreground="Gray" Style="{StaticResource WriteOnlyText}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="CRC 校验">
            <StackPanel Margin="12">
                <CheckBox x:Name="CrcEnabledCheckBox" Content="启用 CRC" IsChecked="{Binding CrcEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <Grid IsEnabled="{Binding CrcEnabled}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource StartOffsetLabel}"/>
                    <TextBox x:Name="CrcStartByteBox" Grid.Column="1" Text="{Binding CrcStartByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource EndOffsetLabel}"/>
                    <TextBox x:Name="CrcEndByteBox" Grid.Row="1" Grid.Column="1" Text="{Binding CrcEndByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <TextBlock Grid.Row="2" Text="结果字节序:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding CrcByteOrder, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                        <ComboBoxItem Content="小端（低字节在前）"/><ComboBoxItem Content="大端（高字节在前）"/>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="CRC 算法:"/>
                    <ComboBox x:Name="CrcAlgorithmBox" Grid.Row="3" Grid.Column="1" IsEnabled="{Binding GenericCrcEditable, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" SelectedIndex="{Binding CrcAlgorithm, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding GenericCrcEditable, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></ComboBox.Style>
                        <ComboBoxItem Content="CRC-8/SMBUS"/><ComboBoxItem Content="CRC-8/SAE-J1850"/><ComboBoxItem Content="CRC-8/AUTOSAR"/>
                        <ComboBoxItem Content="CRC-16/MODBUS"/><ComboBoxItem Content="CRC-16/CCITT-FALSE"/><ComboBoxItem Content="CRC-32/ISO-HDLC"/>
                        <ComboBoxItem Content="自定义 CRC 参数"/>
                        <ComboBoxItem Content="CRC-8/MAXIM-DOW"/><ComboBoxItem Content="CRC-8/ROHC"/><ComboBoxItem Content="CRC-16/ARC"/>
                        <ComboBoxItem Content="CRC-16/X-25"/><ComboBoxItem Content="CRC-16/XMODEM"/><ComboBoxItem Content="CRC-16/KERMIT"/>
                        <ComboBoxItem Content="CRC-16/USB"/><ComboBoxItem Content="CRC-16/DNP"/><ComboBoxItem Content="CRC-32C"/>
                        <ComboBoxItem Content="CRC-32/MPEG-2"/><ComboBoxItem Content="CRC-32/BZIP2"/><ComboBoxItem Content="CRC-32/JAMCRC"/>
                        <ComboBoxItem Content="CRC-64/ECMA-182"/><ComboBoxItem Content="CRC-64/XZ"/>
                    </ComboBox>
                    <TextBlock x:Name="ProfileCrcModelText" Grid.Row="3" Grid.Column="1" Text="由 Profile 固定（实际参数见下方）">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                            <DataTrigger Binding="{Binding GenericCrcEditable, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="CrcSummaryText" Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="Gray">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CrcSummaryConverter}">
                                <Binding/><Binding Path="CrcAlgorithm"/><Binding Path="CrcName"/><Binding Path="CrcWidth"/>
                                <Binding Path="CrcPolynomial"/><Binding Path="CrcInitialValue"/><Binding Path="CrcXorOutput"/>
                                <Binding Path="CrcReflectInput"/><Binding Path="CrcReflectOutput"/>
                                <Binding Path="CrcDataIdEnabled"/><Binding Path="CrcDataIdMode"/><Binding Path="CrcEnabled"/><Binding Path="CrcDataIdUseProfilePlacement"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Row="5" Text="计算起始字节:"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CrcDataStartByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <TextBlock Grid.Row="6" Text="计算结束字节（含，-1=末尾）:"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CrcDataEndByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <TextBlock Grid.Row="7" Text="计算范围内的 CRC 字节:"/>
                    <ComboBox Grid.Row="7" Grid.Column="1" SelectedIndex="{Binding CrcFieldTreatment, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                        <ComboBoxItem Content="跳过这些字节"/><ComboBoxItem Content="按 0x00 参与计算"/>
                    </ComboBox>
                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <CheckBox x:Name="CrcDataIdEnabledCheckBox" Content="将 Data ID 加入 CRC 计算"
                                  IsChecked="{Binding CrcDataIdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <StackPanel IsEnabled="{Binding CrcDataIdEnabled}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Data ID 模式:"/>
                                <ComboBox x:Name="CrcDataIdModeBox" Grid.Column="1" Width="330" SelectedIndex="{Binding CrcDataIdMode, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                                    <ComboBoxItem Content="固定字节（兼容原配置）"/>
                                    <ComboBoxItem Content="Profile 2：Counter 查 16 项表"/>
                                    <ComboBoxItem Content="Profile 1 BOTH：低字节、高字节"/>
                                    <ComboBoxItem Content="Profile 1 ALT：偶数低、奇数高"/>
                                    <ComboBoxItem Content="Profile 1 LOW：仅低字节"/>
                                    <ComboBoxItem Content="Profile 1 NIBBLE：显式半字节"/>
                                </ComboBox>
                            </Grid>
                        <StackPanel x:Name="FixedDataIdPanel" Visibility="{Binding FixedMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Data ID（Hex 字节）:"/>
                            <TextBox x:Name="CrcDataIdHexBox" Grid.Column="1" Width="300" MaxWidth="450" MaxLength="1024"
                                     HorizontalAlignment="Left" Text="{Binding CrcDataIdHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="固定十六进制字节，不是表达式。按填写顺序参与计算；例如 12 34 与 34 12 的顺序不同。"/>
                            <TextBlock Grid.Row="1" Text="加入位置:"/>
                            <ComboBox x:Name="CrcDataIdPlacementBox" Grid.Row="1" Grid.Column="1"
                                      SelectedIndex="{Binding CrcDataIdPlacement, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                                <ComboBoxItem Content="计算范围之前：Data ID + 数据"/>
                                <ComboBoxItem Content="计算范围之后：数据 + Data ID"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="Data ID 为 1～64 字节，可填连续 Hex 或以空格、逗号、短横线分隔，整个字符串可带 0x 前缀。填写顺序就是计算顺序；只参与 CRC，不写入 CAN 数据区，也不会自动使用 CAN ID。" TextWrapping="Wrap" Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel x:Name="ProfileDataIdPanel" Visibility="{Binding ProfileMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="Profile 模式使用固定 CRC 参数，默认按标准拼接 Data ID，也可显式改为自定义前置或后置。仍使用上方显式计算范围；Counter 从当前帧的 4 位字段读取，接收检查使用收到的值。" TextWrapping="Wrap" Foreground="Gray"/>
                            <CheckBox x:Name="CrcDataIdUseProfilePlacementCheckBox" Content="使用 Profile 标准拼接顺序（Profile 1 前置，Profile 2 后置）"
                                      IsChecked="{Binding CrcDataIdUseProfilePlacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <Grid x:Name="CustomProfilePlacementPanel" Visibility="{Binding CustomProfilePlacement, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="自定义加入位置:"/>
                                <ComboBox x:Name="ProfileDataIdPlacementBox" Grid.Column="1" SelectedIndex="{Binding CrcDataIdPlacement, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                                    <ComboBoxItem Content="计算范围之前：Data ID + 数据"/>
                                    <ComboBoxItem Content="计算范围之后：数据 + Data ID"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="ProfilePlacementSummaryText" Text="{Binding ProfilePlacementSummary, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" TextWrapping="Wrap"/>
                            <Border x:Name="CustomProfilePlacementWarning" Background="#FFFFF3CD" BorderBrush="#FFD18B00" BorderThickness="1" Padding="8" Margin="0,0,0,8"
                                    Visibility="{Binding CustomProfilePlacement, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="自定义拼接，不再强制标准 Profile 顺序。请按设备协议选择，收发两端必须一致；切回标准顺序会保留这里的自定义位置设置。" Foreground="#FF8A4F00" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Counter 所在字节:"/>
                                <TextBox x:Name="CrcCounterByteBox" Grid.Column="1" Text="{Binding CrcCounterByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                <TextBlock Grid.Row="1" Text="Counter 位起点（0 或 4）:"/>
                                <TextBox x:Name="CrcCounterBitOffsetBox" Grid.Row="1" Grid.Column="1" Text="{Binding CrcCounterBitOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            </Grid>
                            <StackPanel x:Name="Profile2DataIdPanel" Visibility="{Binding Profile2Mode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="Data ID 表（Counter → 字节；必须提供完整 16 项）" FontWeight="SemiBold"/>
                                <CheckBox x:Name="CrcDataIdTableUseExpressionCheckBox" Content="从表达式读取 Data ID 表"
                                    IsChecked="{Binding CrcDataIdTableUseExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                <Grid x:Name="DataIdTableExpressionPanel" Visibility="{Binding CrcDataIdTableUseExpression, Converter={StaticResource VisibleWhenTrue}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Data ID 表达式（byte[]）:"/>
                                    <expr:ExpressionTextBox x:Name="CrcDataIdTableExpressionBox" Grid.Column="1" Margin="0,0,0,8" MinHeight="28"
                                        ScriptText="{Binding CrcDataIdTableExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="Object"
                                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}"
                                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="结果必须是恰好 16 字节的 byte[]，按下标 0～15 对应 Counter。单次操作或周期任务启动时求值并复制冻结；运行中不轮询、不跟随变量变化，重新启动才使用新表。切换来源会保留内联表。" TextWrapping="Wrap" Foreground="Gray"/>
                                </Grid>
                                <StackPanel x:Name="InlineDataIdTablePanel" Visibility="{Binding InlineTableSource, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                                <ItemsControl x:Name="DataIdTableItems" ItemsSource="{Binding DataIdRows, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Width="160" Margin="0,0,8,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CounterLabel}"/>
                                        <TextBox Grid.Column="1" Width="78" MaxLength="16" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="一个 Hex 字节，例如 AB 或 0xAB；使用设备规范提供的表值。"/>
                                    </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="DataIdTableWarning" Text="{Binding TableWarning, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" TextWrapping="Wrap" Foreground="DarkRed"/>
                                <Button x:Name="ResetDataIdTableButton" Content="新建 16 项空表" Click="OnResetDataIdTable" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="显式清空当前表；新表不包含任何猜测值。"/>
                                </StackPanel>
                                <TextBlock Text="CRC-8/AUTOSAR：2F / FF / FF，无反射。按 Counter 0～15 取表中一个字节，标准顺序在计算范围末尾追加，自定义位置以当前拼接显示为准；不增加 DLC、不发送 Data ID，也不与 Counter 相加。每个报文使用通信矩阵指定的表，不能把规范中的 CRC 示例表当作设备配置。" TextWrapping="Wrap" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel x:Name="Profile1DataIdPanel" Visibility="{Binding Profile1Mode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Profile 1 Data ID（Hex 数值）:"/>
                                    <TextBox x:Name="CrcProfile1DataIdHexBox" Grid.Column="1" MaxLength="16" Text="{Binding CrcProfile1DataIdHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 0123 表示数值 0x0123，低字节为 23，高字节为 01。"/>
                                </Grid>
                                <TextBlock Text="CRC：1D / 00 / 00，无反射；Counter 为 0～14。BOTH 取低字节再高字节；ALT 偶数取低字节、奇数取高字节；LOW 高字节必须为 00。标准顺序将选中输入前置，自定义位置以当前拼接显示为准。" TextWrapping="Wrap" Foreground="Gray"/>
                                <Grid x:Name="Profile1NibblePanel" Visibility="{Binding NibbleMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}, Converter={StaticResource VisibleWhenTrue}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="显式 Data ID 半字节所在字节:"/>
                                    <TextBox x:Name="CrcDataIdNibbleByteBox" Grid.Column="1" Text="{Binding CrcDataIdNibbleByte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                    <TextBlock Grid.Row="1" Text="半字节位起点（0 或 4）:"/>
                                    <TextBox x:Name="CrcDataIdNibbleBitOffsetBox" Grid.Row="1" Grid.Column="1" Text="{Binding CrcDataIdNibbleBitOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="NIBBLE 的 Data ID 最大 0FFF。CRC 的 Data ID 输入为低字节和 00，标准顺序将它们前置；高字节低 4 位显式写入指定位置并随数据参与 CRC。自定义前后置不会改变该显式半字节位置；接收只检查，不改写数据。" TextWrapping="Wrap" Foreground="Gray"/>
                                </Grid>
                            </StackPanel>
                            <Button x:Name="ApplyProfileLayoutButton" Content="应用该 Profile 布局（保留首帧 Counter）" Click="OnApplyProfileLayout" HorizontalAlignment="Left" Margin="0,8,0,8" ToolTip="恢复 Profile 标准拼接顺序。CRC 字节 0，范围 0 到末尾且跳过 CRC；RC 字节 1 低四位。范围从 0 开始，P1 上限 14、P2 上限 15；增量 1，循环。保留用户首帧 Counter、Data ID 值、表和自定义位置设置；首帧值超出新范围时需手动调整。">
                                <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <TextBlock Text="首帧 Counter 在上方 RC 区域设置，P1/P2 均可选 0 或 1，也可填范围内的其他值。Profile 2 首帧为 0 时取表[0]，首帧为 1 时取表[1]；提交后才累加。这里只提供 CRC/Data ID 与 Counter 字段处理，不包含完整 E2E 接收监督状态机。" TextWrapping="Wrap" Foreground="Gray"/>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="9" Grid.ColumnSpan="2" Margin="0,8,0,0" IsEnabled="{Binding GenericCrcEditable, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                            <DataTrigger Binding="{Binding CrcAlgorithm}" Value="{x:Static models:CanCrcAlgorithm.Custom}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding GenericCrcEditable, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="自定义名称:"/>
                        <TextBox Grid.Column="1" Text="{Binding CrcName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="CRC 位宽（8/16/32/64）:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CrcWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <TextBlock Grid.Row="2" Text="多项式 Poly（十六进制）:"/>
                        <TextBox x:Name="CrcPolynomialBox" Grid.Row="2" Grid.Column="1" Text="{Binding CrcPolynomial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Text="初值 Init（十六进制）:"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CrcInitialValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="4" Text="输出异或 XorOut（十六进制）:"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CrcXorOutput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="输入反射 RefIn" IsChecked="{Binding CrcReflectInput, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="输出反射 RefOut" IsChecked="{Binding CrcReflectOutput, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="十六进制参数可带 0x；多项式使用普通表示法，不含最高位，不能填写反射后的多项式。" TextWrapping="Wrap" Foreground="Gray"/>
                    </Grid>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Text" Value="写入长度须与 CRC 位宽一致，RC 与 CRC 写入区不能重叠。计算范围按 Data 字节偏移选择，可额外加入启用的 Data ID；需要计算 CAN FD 补齐字节时，请在 Data 中显式填写。"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ReadMode, RelativeSource={RelativeSource AncestorType=views:PayloadProtectionEditorView}}" Value="True"><Setter Property="Text" Value="CRC 字段长度须与位宽一致。DBC 接收按定义长度选择计算范围，并加入启用的 Data ID；CRC 不符保留原始报文和检查结果，由序列进行合格判定。"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style></TextBlock>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
