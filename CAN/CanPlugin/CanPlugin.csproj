<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

	<Version>1.0.29</Version>
  
	<TargetFramework>net8.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>CAN.StepPlugin</AssemblyName>
	<RootNamespace>CAN</RootNamespace>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<OutputPath>..\..\..\xTestPlatform\xTestPlatform\bin\$(Configuration)\$(TargetFramework)\win-x64\Plugins\CAN\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>

	<PackageReference Include="MessagePack" />
	<PackageReference Include="xTestPlatform.StepEditor.SDK" />

  </ItemGroup>

  <!-- 复制随插件发布的 ZLGCAN 原生库（x64）及 kerneldlls 子目录至输出目录 Native\Zlg\ -->
  <ItemGroup>
	<None Include="Native\Zlg\x64\**\*.*" Exclude="Native\Zlg\x64\**\*.md;Native\Zlg\x64\**\*.h;Native\Zlg\x64\**\*.lib;Native\Zlg\x64\**\.gitkeep">
	  <Link>Native\Zlg\%(RecursiveDir)%(Filename)%(Extension)</Link>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

</Project>
