<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Version>1.2.12</Version>
	<TargetFramework>net8.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>CAN.StepPlugin</AssemblyName>
	<RootNamespace>CAN</RootNamespace>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<OutputPath>..\..\..\xTestPlatform\xTestPlatform\bin\$(Configuration)\$(TargetFramework)\win-x64\Plugins\CAN\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="MessagePack" Version="3.1.8" />
	<PackageReference Include="xTestPlatform.StepEditor.SDK" Version="1.2.3" />
  </ItemGroup>

  <!-- ������ ZLGCAN ԭ���⣨x64�������� kerneldlls ��Ŀ¼�ṹ���Ƶ� ���Ŀ¼\Native\Zlg\ -->
  <ItemGroup>
	<None Include="Native\Zlg\x64\**\*.*" Exclude="Native\Zlg\x64\**\*.md;Native\Zlg\x64\**\*.h;Native\Zlg\x64\**\*.lib;Native\Zlg\x64\**\.gitkeep">
	  <Link>Native\Zlg\%(RecursiveDir)%(Filename)%(Extension)</Link>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

</Project>
