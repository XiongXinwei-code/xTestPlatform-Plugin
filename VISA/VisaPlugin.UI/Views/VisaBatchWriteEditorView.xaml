<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Class="VISA.UI.Views.VisaBatchWriteEditorView">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="VISA BatchWrite"
                               Image="pack://application:,,,/VISA.StepPlugin.UI;component/Resources/Icons/visa.png"
                               ImageHeight="20" ImageWidth="20">
            <DockPanel Margin="16">
                <!-- 连接名称 -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="连接名称:" VerticalAlignment="Center"/>
                    <expr:ExpressionTextBox Grid.Column="1"
                        ScriptText="{Binding ConnectionName, Mode=TwoWay}"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>

                <!-- 工具栏 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="添加命令" Click="OnAddClick" Padding="8,4" Margin="0,0,8,0"/>
                    <Button Content="删除选中" Click="OnRemoveClick" Padding="8,4"/>
                </StackPanel>

                <!-- 命令列表 -->
                <DataGrid x:Name="CommandGrid" ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SCPI 命令" Binding="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="延时(ms)" Binding="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
