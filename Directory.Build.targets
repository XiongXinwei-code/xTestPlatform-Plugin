<Project>

  <!--
    Fix for WPF markup compiler error MC1000: cannot find mscorlib.dll.

    Some microsoft.netcore.app.ref patch packages (e.g. 8.0.28) are extracted
    incompletely on certain machines / CI runners, missing the mscorlib.dll
    facade assembly under the net8.0 ref directory. WPF projects that trigger
    GenerateTemporaryTargetAssembly (creating *_wpftmp.csproj) do a hard file
    existence check on it during markup compilation, causing the build to fail.

    This target copies the sibling System.Runtime.dll to mscorlib.dll before
    markup compilation, only when it is missing. Source and destination are
    both derived from the same item list so their counts always match (avoids MSB3094).
  -->
  <Target Name="_EnsureMscorlibReferenceAssembly"
          AfterTargets="ResolveReferences"
          BeforeTargets="MarkupCompilePass1;MarkupCompilePass2;GenerateTemporaryTargetAssembly">

    <ItemGroup>
      <_SysRuntimeForMscorlib Include="@(ReferencePathWithRefAssemblies)"
          Condition="'%(FileName)' == 'System.Runtime' And !Exists('%(RootDir)%(Directory)mscorlib.dll')" />
    </ItemGroup>

    <Copy Condition="'@(_SysRuntimeForMscorlib)' != ''"
          SourceFiles="@(_SysRuntimeForMscorlib)"
          DestinationFiles="@(_SysRuntimeForMscorlib->'%(RootDir)%(Directory)mscorlib.dll')"
          SkipUnchangedFiles="true" />

    <Message Condition="'@(_SysRuntimeForMscorlib)' != ''"
             Importance="high"
             Text="[WPF Fix] Created missing mscorlib.dll: @(_SysRuntimeForMscorlib->'%(RootDir)%(Directory)mscorlib.dll')" />

  </Target>

</Project>
