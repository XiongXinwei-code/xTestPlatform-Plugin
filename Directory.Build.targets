<Project>

  <!--
    Repair for an incompletely-extracted / corrupted microsoft.netcore.app.ref NuGet
    package where the tiny mscorlib.dll reference facade is missing.

    Only the WPF markup compiler (Microsoft.WinFX.targets, MC1000) hard-requires an
    assembly whose identity is "mscorlib"; ordinary CoreCompile does not, which is why
    non-WPF plugins still build. Copying System.Runtime.dll does NOT work because the
    WPF metadata resolver matches on assembly identity, so we must provide a genuine
    mscorlib reference facade taken from the SDK-installed targeting pack.
  -->
  <Target Name="_EnsureMscorlibReferenceAssembly"
          AfterTargets="ResolveReferences"
          BeforeTargets="MarkupCompilePass1;MarkupCompilePass2;GenerateTemporaryTargetAssembly">

    <!-- Locate System.Runtime.dll among resolved references to derive the target ref folder. -->
    <ItemGroup>
      <_SysRuntimeRef Include="@(ReferencePathWithRefAssemblies->WithMetadataValue('FileName','System.Runtime'))" />
      <_SysRuntimeRef Include="@(ReferencePath->WithMetadataValue('FileName','System.Runtime'))" Condition="'@(_SysRuntimeRef)' == ''" />
    </ItemGroup>

    <PropertyGroup>
      <_MscorlibDest Condition="'@(_SysRuntimeRef)' != ''">%(_SysRuntimeRef.RootDir)%(_SysRuntimeRef.Directory)mscorlib.dll</_MscorlibDest>
    </PropertyGroup>

    <!-- Only act when the destination facade is genuinely missing. -->
    <ItemGroup Condition="'$(_MscorlibDest)' != '' and !Exists('$(_MscorlibDest)')">
      <!-- Genuine mscorlib facades bundled with installed targeting packs (preferred, correct identity). -->
      <_MscorlibSource Include="$(NetCoreRoot)packs\Microsoft.NETCore.App.Ref\**\ref\net8.0\mscorlib.dll" />
      <_MscorlibSource Include="$(NetCoreRoot)packs\Microsoft.NETCore.App.Ref\**\ref\net*.0\mscorlib.dll" Condition="'@(_MscorlibSource)' == ''" />
    </ItemGroup>

    <PropertyGroup Condition="'$(_MscorlibDest)' != '' and !Exists('$(_MscorlibDest)')">
      <_MscorlibSourceFile>@(_MscorlibSource)</_MscorlibSourceFile>
      <_MscorlibSourceFirst>$(_MscorlibSourceFile.Split(';')[0])</_MscorlibSourceFirst>
    </PropertyGroup>

    <Copy Condition="'$(_MscorlibSourceFirst)' != '' and Exists('$(_MscorlibSourceFirst)')"
          SourceFiles="$(_MscorlibSourceFirst)"
          DestinationFiles="$(_MscorlibDest)"
          SkipUnchangedFiles="true" />

    <Message Condition="'$(_MscorlibSourceFirst)' != '' and Exists('$(_MscorlibSourceFirst)')"
             Importance="high"
             Text="[WPF Fix] Restored missing mscorlib reference facade: $(_MscorlibDest) (from $(_MscorlibSourceFirst))" />

    <Warning Condition="'$(_MscorlibDest)' != '' and !Exists('$(_MscorlibDest)') and '$(_MscorlibSourceFirst)' == ''"
             Text="[WPF Fix] mscorlib.dll is missing at $(_MscorlibDest) but no genuine source facade was found under $(NetCoreRoot)packs\Microsoft.NETCore.App.Ref." />

  </Target>

</Project>
