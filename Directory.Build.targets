<Project>
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Plugin')) and !$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('WidgetPlugin'))">
    <DefineConstants>$(DefineConstants);PLUGIN_$(RootNamespace)</DefineConstants>
  </PropertyGroup>
  <!-- Private source links keep plugin folders independently deployable. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Plugin')) and !$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('WidgetPlugin'))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Serialization/*.cs" Link="Internal/Serialization/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/PendingIoGate.cs" Link="Internal/PendingIoGate.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/RetiringResources.cs" Link="Internal/RetiringResources.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/ExecutionEpoch.cs" Link="Internal/ExecutionEpoch.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/OwnerStopSignal.cs" Link="Internal/OwnerStopSignal.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/ExecutionScopedExecutor.cs" Link="Internal/ExecutionScopedExecutor.cs" />
  </ItemGroup>
  <!-- WPF temporary projects are named FooPlugin.UI_<id>_wpftmp, not FooPlugin.UI. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('Plugin.UI'))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/UI/EditorSaveScheduler.cs" Exclude="@(Compile)" Link="Internal/EditorSaveScheduler.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/UI/PluginEditorCommit.cs" Exclude="@(Compile)" Link="Internal/PluginEditorCommit.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/UI/VariableDrop.cs" Exclude="@(Compile)" Link="Internal/VariableDrop.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/UI/PluginEditorScrolling.cs" Exclude="@(Compile)" Link="Internal/PluginEditorScrolling.cs" />
    <Page Include="$(MSBuildThisFileDirectory)Shared/UI/PluginEditorScrollingResources.xaml" Exclude="@(Page)" Link="Internal/PluginEditorScrollingResources.xaml" />
  </ItemGroup>
</Project>
