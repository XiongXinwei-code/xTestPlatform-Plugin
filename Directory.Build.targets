<Project>

  <!--
	修复 WPF 标记编译器（MC1000）找不到 mscorlib.dll 的问题。

	背景：某些 microsoft.netcore.app.ref 补丁包（如 8.0.28）在 CI/runner 上解压后
	缺失 net8.0 引用目录中的 mscorlib.dll 门面程序集。触发 GenerateTemporaryTargetAssembly
	（生成 *_wpftmp.csproj）的 WPF 项目在标记编译时会对该文件做硬性存在检查，导致构建失败。

	该 Target 在标记编译前，从同目录的 System.Runtime.dll 复制生成一个有效的占位程序集，
	确保 mscorlib.dll 存在。对本机开发与 CI 均生效，且会被生成的 _wpftmp 项目继承。
  -->
  <Target Name="_EnsureMscorlibReferenceAssembly"
		  AfterTargets="ResolveReferences"
		  BeforeTargets="MarkupCompilePass1;MarkupCompilePass2;GenerateTemporaryTargetAssembly">

	<PropertyGroup>
	  <_SystemRuntimeRefPath>@(ReferencePathWithRefAssemblies->WithMetadataValue('FileName','System.Runtime')->'%(FullPath)')</_SystemRuntimeRefPath>
	  <_SystemRuntimeRefPath Condition="'$(_SystemRuntimeRefPath)' == ''">@(ReferencePath->WithMetadataValue('FileName','System.Runtime')->'%(FullPath)')</_SystemRuntimeRefPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_SystemRuntimeRefPath)' != ''">
	  <_RefAssemblyDir>$([System.IO.Path]::GetDirectoryName('$(_SystemRuntimeRefPath)'))</_RefAssemblyDir>
	  <_MscorlibRefPath>$(_RefAssemblyDir)\mscorlib.dll</_MscorlibRefPath>
	</PropertyGroup>

	<Copy Condition="'$(_SystemRuntimeRefPath)' != '' And !Exists('$(_MscorlibRefPath)')"
		  SourceFiles="$(_SystemRuntimeRefPath)"
		  DestinationFiles="$(_MscorlibRefPath)"
		  SkipUnchangedFiles="true" />

	<Message Condition="'$(_SystemRuntimeRefPath)' != '' And !Exists('$(_MscorlibRefPath)')"
			 Importance="high"
			 Text="[WPF 修复] 已在引用包目录补齐 mscorlib.dll: $(_MscorlibRefPath)" />

  </Target>

</Project>
