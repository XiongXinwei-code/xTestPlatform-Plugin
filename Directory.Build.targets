<Project>
  <!-- Private source links keep plugin folders independently deployable. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Plugin'))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/PendingIoGate.cs" Link="Internal/PendingIoGate.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/RetiringResources.cs" Link="Internal/RetiringResources.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime/ExecutionEpoch.cs" Link="Internal/ExecutionEpoch.cs" />
  </ItemGroup>
  <!-- WPF temporary projects are named FooPlugin.UI_<id>_wpftmp, not FooPlugin.UI. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('Plugin.UI'))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/UI/EditorSaveScheduler.cs" Exclude="@(Compile)" Link="Internal/EditorSaveScheduler.cs" />
  </ItemGroup>
</Project>
