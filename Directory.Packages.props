<Project>
  <PropertyGroup>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
	<!-- xTestPlatform 插件 SDK -->
	<PackageVersion Include="xTestPlatform.StepEditor.SDK" Version="1.2.4" />

	<!-- 序列化：须 ≥ xTestPlatform.Core 引用的版本，否则报 CS1705 -->
	<PackageVersion Include="MessagePack" Version="3.1.8" />

	<!-- UI / MVVM -->
	<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	<PackageVersion Include="AvalonEdit" Version="6.3.0.90" />
	<PackageVersion Include="MaterialDesignThemes" Version="5.3.0" />
	<PackageVersion Include="Syncfusion.Themes.Windows11Light.WPF" Version="32.1.25" />
	<PackageVersion Include="Syncfusion.SfSkinManager.WPF" Version="32.1.25" />
	<PackageVersion Include="Syncfusion.Tools.WPF" Version="32.1.25" />
	<PackageVersion Include="Syncfusion.GridCommon.Wpf" Version="32.1.25" />
	<PackageVersion Include="Syncfusion.SfGrid.WPF" Version="32.1.25" />
	<PackageVersion Include="Syncfusion.SfInput.WPF" Version="32.1.25" />
	<PackageVersion Include="Syncfusion.SfBusyIndicator.WPF" Version="32.2.3" />

	<!-- 通信协议 -->
	<PackageVersion Include="NModbus" Version="3.0.81" />
	<PackageVersion Include="System.IO.Ports" Version="8.0.0" />
	<PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.374.126" />
	<PackageVersion Include="IviFoundation.Visa" Version="8.0.2" />
  </ItemGroup>
</Project>
