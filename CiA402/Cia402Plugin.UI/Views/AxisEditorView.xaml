<UserControl x:Class="CiA402.UI.Views.AxisEditorView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="Visible" />
	</UserControl.Resources>
	<syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
		<syncfusion:TabItemExt Header="{Binding Title}" Image="{Binding IconPath}" ImageHeight="20" ImageWidth="20">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="16">
					<TextBlock Text="周期目标由序列循环编排：非实时控制，不保证确定性周期。EtherCAT 需另行接入主站适配器。" TextWrapping="Wrap" Margin="0,0,0,12" />
					<TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8" />
					<ItemsControl ItemsSource="{Binding Fields}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Visible}}" Margin="0,0,0,12">
									<TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,4" />
									<expr:ExpressionTextBox ScriptText="{Binding ExpressionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String"
										Visibility="{Binding IsStringExpression, Converter={StaticResource Visible}}"
										SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
										EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
									<expr:ExpressionTextBox ScriptText="{Binding ExpressionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="Double"
										Visibility="{Binding IsNumericExpression, Converter={StaticResource Visible}}"
										SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
										EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
									<TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" />
									<CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" Content="启用" />
									<ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EnumValue, Mode=TwoWay}" Visibility="{Binding IsEnum, Converter={StaticResource Visible}}" />
									<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
									<TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>
		</syncfusion:TabItemExt>
	</syncfusion:TabControlExt>
</UserControl>