<UserControl x:Class="CiA402.UI.Views.BindAxisEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="CiA402_BindAxis" Image="pack://application:,,,/CiA402.StepPlugin.UI;component/Resources/Icons/cia402_bindaxis.png" ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="周期目标由序列循环编排：非实时控制，不保证确定性周期。EtherCAT 需另行接入主站适配器。" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock x:Name="BindingSafetyHint" Text="允许绑定已使能、QuickStop 或故障状态的轴。绑定只核对通信与映射，不自动停轴、使能、切模式或改目标；绑定成功不代表驱动已停止。只读会话解绑不主动发送停轴指令，执行控制步骤后仍按原策略清理。" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" />
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="通信后端" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <ComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding Transport, Mode=TwoWay}" />
                        <TextBlock Text="EtherCAT 必须注册主站适配工厂" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="连接名" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox ScriptText="{Binding ConnectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="求值结果为 string；CAN_Open 连接或 EtherCAT 主站连接" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <TextBlock Text="CANopen 节点" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox ScriptText="{Binding NodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="Double"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="求值结果为整数；不允许广播" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsEtherCAT, Converter={StaticResource Visible}}">
                        <TextBlock Text="EtherCAT 从站地址" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox ScriptText="{Binding SlaveAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="Double"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="求值结果为整数；含义由主站适配器定义" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="轴对象索引偏移" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding ObjectIndexOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="标准 0x6000~0x67FF 对象的显式偏移；按设备手册配置" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="单次通信超时（ms）" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding CommunicationTimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="阻塞通信软超时；不得无限等待" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="轴清理总超时（ms）" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="ShutdownTimeoutEditor" Text="{Binding ShutdownTimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="默认 2000；范围 1~3600000。等待活动操作、停轴/释放使能及本轴传输释放共用预算；显式解绑还受解绑步骤总超时限制。不会关闭父 CAN，也不会提前释放仍在执行的底层调用。" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="反馈有效期（ms）" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding FeedbackMaxAgeMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="共享队列驻留有效期及多 TPDO 时间戳合并窗口；不保证硬件采样年龄或同一 SYNC 周期。被动 TPDO 缺帧返回失败，接收退出后可退避重读；此参数不是通信取消期限。" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <TextBlock Text="CSP RPDO 编号" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding CspPdoNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="0 表示未配置；1 对应 0x1400/0x1600，绑定时核对设备映射" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <TextBlock Text="CSP RPDO 布局" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding CspPdoLayout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="显式索引:子索引:位数，逗号分隔；仅允许目标位置及可选控制字" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <TextBlock Text="CSV RPDO 编号" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding CsvPdoNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="0 表示未配置；不自动重配驱动" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <TextBlock Text="CSV RPDO 布局" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding CsvPdoLayout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="显式索引:子索引:位数；仅允许目标速度及可选控制字" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <TextBlock Text="CST RPDO 编号" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding CstPdoNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="0 表示未配置；不自动重配驱动" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <TextBlock Text="CST RPDO 布局" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding CstPdoLayout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="显式索引:子索引:位数；仅允许目标转矩及可选控制字" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsSingleFeedbackPdo, Converter={StaticResource Visible}}">
                        <TextBlock Text="反馈 TPDO 编号" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding FeedbackPdoNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="0 使用 SDO 顺序读取；非零使用指定 TPDO，须包含状态字" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsSingleFeedbackPdo, Converter={StaticResource Visible}}">
                        <TextBlock Text="反馈 TPDO 布局" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding FeedbackPdoLayout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="完整描述设备已有映射；解码 0x6041、0x6064、0x606C、0x6077，其他对象按长度跳过。索引须含轴偏移。" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCANopen, Converter={StaticResource Visible}}">
                        <CheckBox Content="使用多个反馈 TPDO" IsChecked="{Binding UseMultipleFeedbackPdos, Mode=TwoWay}" />
                        <TextBlock Text="关闭时使用上方旧单 TPDO / SDO 设置；开启后仅使用下表，不自动修改驱动器映射。" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsMultipleFeedbackPdos, Converter={StaticResource Visible}}">
                        <TextBlock Text="反馈 TPDO 列表" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <DataGrid x:Name="FeedbackPdoGrid" ItemsSource="{Binding FeedbackPdos}"
                                  SelectedItem="{Binding SelectedFeedbackPdo, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  MinHeight="100" MaxHeight="260" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TPDO 编号" Width="100" Binding="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                <DataGridTextColumn Header="映射布局（索引:子索引:位数）" Width="*" Binding="{Binding Layout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <Button Content="添加 TPDO" Command="{Binding AddFeedbackPdoCommand}" Margin="0,0,8,0" Padding="10,3" />
                            <Button Content="删除选中项" Command="{Binding RemoveFeedbackPdoCommand}" Padding="10,3" />
                        </StackPanel>
                        <TextBlock Text="示例：TPDO1=状态字+位置；TPDO2=速度+转矩，每帧不超过 8 字节。整体须含状态字；重复字段采用上方靠前的来源。" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Text="仅收集本次输出所需的帧，共用单次通信期限；反馈有效期也约束合并窗口，不保证同一 SYNC 周期或硬件采样年龄。" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="硬件诊断对象索引" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding DiagnosticIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="0 表示未配置；按设备手册填写实际索引，不自动加轴偏移" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="硬件诊断子索引" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding DiagnosticSubIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="设备定义的诊断对象子索引" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="硬件诊断字节数" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding DiagnosticBytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="支持 1、2、4 字节无符号值" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="硬件异常位掩码" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding DiagnosticMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="0 只读取；非零时匹配异常值会阻止运动操作" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="硬件异常匹配值" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding DiagnosticActiveValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="(诊断值 &amp; 掩码) 等于此值时视为硬件条件不满足" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="轴会话名" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox ScriptText="{Binding AxisName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="求值结果为 string；必须先绑定该轴" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="步骤总超时（ms）" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="包括通信和轮询的总超时" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="轮询间隔（ms）" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding PollIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="非实时轮询间隔，不代表完整周期" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
