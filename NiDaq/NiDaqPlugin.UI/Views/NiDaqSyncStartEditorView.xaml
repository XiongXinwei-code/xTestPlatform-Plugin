<UserControl x:Class="NiDaq.UI.Views.NiDaqSyncStartEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox">
    <syncfusion:TabControlExt>
        <syncfusion:TabItemExt Header="同步采集设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="任务名称" VerticalAlignment="Center"/>
                        <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" ScriptText="{Binding TaskName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="采样率 (Hz)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SampleRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="最大时长 (ms)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxDurationMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="输出目录" VerticalAlignment="Center"/>
                        <expr:ExpressionTextBox Grid.Row="3" Grid.Column="1" ScriptText="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="统计变量前缀" VerticalAlignment="Center"/>
                        <expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" ScriptText="{Binding StatVariablePrefix, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="导出格式" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" SelectedItem="{Binding ExportFormat}" Margin="0,0,0,8"/>
                        <CheckBox Grid.Row="6" Grid.Column="1" Content="使用外部触发" IsChecked="{Binding UseTrigger}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="触发源" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TriggerSource, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Text="AI 通道" FontWeight="Bold" Margin="0,12,0,4"/>
                    <DataGrid ItemsSource="{Binding AiChannels}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="60">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物理通道" Binding="{Binding PhysicalChannel}" Width="*"/>
                            <DataGridTextColumn Header="列名" Binding="{Binding ColumnName}" Width="80"/>
                            <DataGridTextColumn Header="最小值" Binding="{Binding MinValue}" Width="60"/>
                            <DataGridTextColumn Header="最大值" Binding="{Binding MaxValue}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="添加AI" Click="AddAiChannel_Click" Margin="0,0,8,0"/>
                        <Button Content="删除AI" Click="RemoveAiChannel_Click"/>
                    </StackPanel>
                    <TextBlock Text="编码器通道" FontWeight="Bold" Margin="0,12,0,4"/>
                    <DataGrid ItemsSource="{Binding EncoderChannels}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="60">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Counter" Binding="{Binding CounterChannel}" Width="*"/>
                            <DataGridTextColumn Header="列名" Binding="{Binding ColumnName}" Width="80"/>
                            <DataGridTextColumn Header="PPR" Binding="{Binding PulsesPerRevolution}" Width="60"/>
                            <DataGridTextColumn Header="每脉冲" Binding="{Binding DistancePerPulse}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="添加编码器" Click="AddEncoderChannel_Click" Margin="0,0,8,0"/>
                        <Button Content="删除编码器" Click="RemoveEncoderChannel_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
