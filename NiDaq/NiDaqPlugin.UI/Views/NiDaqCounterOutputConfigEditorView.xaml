<UserControl x:Class="NiDaq.UI.Views.NiDaqCounterOutputConfigEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:skin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
 xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox" skin:SfSkinManager.Theme="{skin:SkinManagerExtension ThemeName=Windows11Light}">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="CounterOutputConfig" Image="pack://application:,,,/NiDaq.StepPlugin.UI;component/Resources/Icons/nidaq_co_config.png" ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid Margin="16" MinWidth="550" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TaskName" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="任务名表达式，求值结果为 string；配置后由 TaskStart/TaskStop 管理"/>
                    <expr:ExpressionTextBox x:Name="TaskNameBox" Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" ScriptText="{Binding TaskName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String" SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}" EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Grid.Row="1" Text="TimeoutMs" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="操作总期限 ms，大于0；包含表达式、排队和SDK调用"/>
                    <TextBox x:Name="TimeoutMsBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Text="{Binding TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="CounterChannel" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="求值结果为 string，只允许一个计数器，如 Dev1/ctr0"/>
                    <expr:ExpressionTextBox x:Name="CounterChannelBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" ScriptText="{Binding CounterChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String" SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}" EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Grid.Row="3" Text="OutputTerminal" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="输出终端普通文本；空使用设备默认路由"/>
                    <TextBox x:Name="OutputTerminalBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" Text="{Binding OutputTerminal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="4" Text="Frequency" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="脉冲频率 Hz，有限正数"/>
                    <TextBox x:Name="FrequencyBox" Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" Text="{Binding Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="5" Text="DutyCycle" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="占空比，严格位于0和1之间"/>
                    <TextBox x:Name="DutyCycleBox" Grid.Row="5" Grid.Column="1" Margin="0,4,0,4" Text="{Binding DutyCycle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="6" Text="InitialDelaySeconds" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="首脉冲前延迟秒数，有限非负"/>
                    <TextBox x:Name="InitialDelaySecondsBox" Grid.Row="6" Grid.Column="1" Margin="0,4,0,4" Text="{Binding InitialDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="7" Text="IdleState" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="输出静止电平 Low / High"/>
                    <ComboBox x:Name="IdleStateBox" Grid.Row="7" Grid.Column="1" Margin="0,4,0,4" Width="240" HorizontalAlignment="Left" ItemsSource="{Binding IdleStateValues}" SelectedItem="{Binding IdleState, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="8" Text="SampleMode" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="FiniteSamples / ContinuousSamples"/>
                    <ComboBox x:Name="SampleModeBox" Grid.Row="8" Grid.Column="1" Margin="0,4,0,4" Width="240" HorizontalAlignment="Left" ItemsSource="{Binding SampleModeValues}" SelectedItem="{Binding SampleMode, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="9" Text="PulseCount" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="有限模式输出脉冲数；连续模式为定时配置数量，须大于0"/>
                    <TextBox x:Name="PulseCountBox" Grid.Row="9" Grid.Column="1" Margin="0,4,0,4" Text="{Binding PulseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="10" Text="UseTrigger" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="是否启用数字边沿启动触发"/>
                    <CheckBox x:Name="UseTriggerBox" Grid.Row="10" Grid.Column="1" Margin="0,4,0,4" IsChecked="{Binding UseTrigger, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="11" Text="TriggerSource" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="触发终端普通文本；启用时必填"/>
                    <TextBox x:Name="TriggerSourceBox" Grid.Row="11" Grid.Column="1" Margin="0,4,0,4" Text="{Binding TriggerSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="12" Text="TriggerEdge" VerticalAlignment="Center" Margin="0,4,12,4" ToolTip="Rising / Falling"/>
                    <ComboBox x:Name="TriggerEdgeBox" Grid.Row="12" Grid.Column="1" Margin="0,4,0,4" Width="240" HorizontalAlignment="Left" ItemsSource="{Binding TriggerEdgeValues}" SelectedItem="{Binding TriggerEdge, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="13" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray" Text="使用 DAQmx 隐式定时；连续模式保持运行直到 TaskStop/执行资源清理。Stop 终止并释放任务，不保证负载已停止或某种电平安全。已有未知原生操作时保留原 owner，不能强清句柄。"/>
                </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
