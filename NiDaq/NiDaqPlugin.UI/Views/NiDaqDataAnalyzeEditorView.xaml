<UserControl x:Class="NiDaq.UI.Views.NiDaqDataAnalyzeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox">
    <syncfusion:TabControlExt>
        <syncfusion:TabItemExt Header="数据分析">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件路径" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" ScriptText="{Binding FilePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="通道名称" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" ScriptText="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="分析模式" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Mode}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="参考通道" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="3" Grid.Column="1" ScriptText="{Binding ReferenceChannel, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="区间起始" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="区间结束" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="结果变量" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="6" Grid.Column="1" ScriptText="{Binding ResultVariable, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="峰值参考变量" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="7" Grid.Column="1" ScriptText="{Binding RefAtPeakVariable, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String"/>
            </Grid>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
