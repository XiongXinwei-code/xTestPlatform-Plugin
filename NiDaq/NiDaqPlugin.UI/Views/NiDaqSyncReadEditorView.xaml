<UserControl x:Class="NiDaq.UI.Views.NiDaqSyncReadEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:NiDaq.Models;assembly=NiDaq.StepPlugin"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="DaqExportFormatValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DaqExportFormat"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="同步读取"
                               Image="pack://application:,,,/NiDaq.StepPlugin.UI;component/Resources/Icons/nidaq.png"
                               ImageHeight="20" ImageWidth="20">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="任务名称" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" ScriptText="{Binding TaskName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="System.String" Margin="0,0,0,8"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="读取样本数" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SamplesToRead, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="读取超时 (ms)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReadTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="结果变量" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="3" Grid.Column="1" ScriptText="{Binding ResultVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="System.String" Margin="0,0,0,8"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </syncfusion:TabItemExt>
        <syncfusion:TabItemExt Header="数据存盘">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="启用存盘" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding SaveToFile}" Content="将采集数据保存到文件" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="导出格式" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Source={StaticResource DaqExportFormatValues}}" SelectedItem="{Binding ExportFormat}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                          IsEnabled="{Binding SaveToFile}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="输出目录" VerticalAlignment="Center"/>
                <expr:ExpressionTextBox Grid.Row="2" Grid.Column="1" ScriptText="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="System.String"
                    IsEnabled="{Binding SaveToFile}"
                    SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="文件大小上限 (MB)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxFileSizeMB, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                         IsEnabled="{Binding SaveToFile}"/>
            </Grid>
        </syncfusion:TabItemExt>
        <syncfusion:TabItemExt Header="自定义事件">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="启用事件" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableCustomEvent}" Content="读取后发送自定义事件" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="事件名称" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomEventName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,8"
                         IsEnabled="{Binding EnableCustomEvent}"/>
            </Grid>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
