<UserControl x:Class="NiDaq.UI.Views.NiDaqAiAcquireEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox">
    <syncfusion:TabControlExt>
        <syncfusion:TabItemExt Header="AI 单次采集">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="采样率 (Hz)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SampleRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="采样数/通道" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SamplesPerChannel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="变量前缀" VerticalAlignment="Center"/>
                    <expr:ExpressionTextBox Grid.Row="2" Grid.Column="1" ScriptText="{Binding ResultVariablePrefix, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ExpectedResultType="System.String"/>
                </Grid>
                <TextBlock Text="通道列表" FontWeight="Bold" Margin="0,12,0,4"/>
                <DataGrid ItemsSource="{Binding Channels}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="100">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="物理通道" Binding="{Binding PhysicalChannel}" Width="*"/>
                        <DataGridTextColumn Header="列名" Binding="{Binding ColumnName}" Width="80"/>
                        <DataGridTextColumn Header="最小值" Binding="{Binding MinValue}" Width="60"/>
                        <DataGridTextColumn Header="最大值" Binding="{Binding MaxValue}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="添加通道" Click="AddChannel_Click" Margin="0,0,8,0"/>
                    <Button Content="删除通道" Click="RemoveChannel_Click"/>
                </StackPanel>
            </StackPanel>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
