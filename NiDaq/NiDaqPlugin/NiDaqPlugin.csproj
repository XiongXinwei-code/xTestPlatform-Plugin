<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Version>1.0.3</Version>
	<TargetFramework>net8.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>NiDaq.StepPlugin</AssemblyName>
	<RootNamespace>NiDaq</RootNamespace>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<EnableDynamicLoading>true</EnableDynamicLoading>
	<OutputPath>..\..\..\xTestPlatform\xTestPlatform\bin\$(Configuration)\$(TargetFramework)\win-x64\Plugins\NiDaq\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="MessagePack" Version="3.1.7" />
	<PackageReference Include="xTestPlatform.StepEditor.SDK" Version="1.2.1" />
  </ItemGroup>

  <!-- NI DAQmx + TDMS DLL references from repo-local libs folder (64-bit runtime assemblies), buildable on CI and dev machines -->
  <!-- NOTE: target machine still requires NI-DAQmx driver installed at runtime -->
  <ItemGroup>
	<Reference Include="NationalInstruments.DAQmx">
	  <HintPath>..\libs\NationalInstruments.DAQmx.dll</HintPath>
	  <Private>true</Private>
	</Reference>
	<Reference Include="NationalInstruments.Common">
	  <HintPath>..\libs\NationalInstruments.Common.dll</HintPath>
	  <Private>true</Private>
	</Reference>
	<Reference Include="NationalInstruments.Tdms">
	  <HintPath>..\libs\NationalInstruments.Tdms.dll</HintPath>
	  <Private>true</Private>
	</Reference>
  </ItemGroup>

</Project>
