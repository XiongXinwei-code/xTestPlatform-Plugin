<UserControl x:Class="SerialPortPlugin.UI.Views.SerialPortOpenEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="SerialPort Open">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="端口名:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Text="波特率:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8">
                    <ComboBoxItem Content="9600"/>
                    <ComboBoxItem Content="19200"/>
                    <ComboBoxItem Content="38400"/>
                    <ComboBoxItem Content="57600"/>
                    <ComboBoxItem Content="115200"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="数据位:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8">
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Text="停止位:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding StopBits}" Margin="0,0,0,8">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="One"/>
                    <ComboBoxItem Content="Two"/>
                    <ComboBoxItem Content="OnePointFive"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Text="校验位:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="{Binding Parity}" Margin="0,0,0,8">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Odd"/>
                    <ComboBoxItem Content="Even"/>
                    <ComboBoxItem Content="Mark"/>
                    <ComboBoxItem Content="Space"/>
                </ComboBox>

                <TextBlock Grid.Row="5" Text="读超时 (ms):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ReadTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="6" Text="写超时 (ms):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WriteTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
            </Grid>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
