<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>SerialPort.StepPlugin</AssemblyName>
		<RootNamespace>SerialPort</RootNamespace>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="3.1.7" />
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
		<PackageReference Include="xTestPlatform.StepEditor.SDK" Version="1.0.14" />
	</ItemGroup>

</Project>
