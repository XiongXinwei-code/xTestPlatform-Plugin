<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             x:Class="Http.UI.Views.HttpClientCreateEditorView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="Http ClientCreate"
                               Image="pack://application:,,,/Http.StepPlugin.UI;component/Resources/Icons/http_client_create.png"
                               ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="客户端名称:" VerticalAlignment="Center" Margin="0,6" />
                    <expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
                        ScriptText="{Binding ClientName, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="服务基地址:" VerticalAlignment="Center" Margin="0,6" />
                    <expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,6"
                        ScriptText="{Binding BaseUrl, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="建立/请求超时(ms):" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"
                             Text="{Binding TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="认证方式:" VerticalAlignment="Center" Margin="0,6" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding AuthModes}" SelectedItem="{Binding AuthMode, Mode=TwoWay}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="用户名:" VerticalAlignment="Center" Margin="0,6"
                               Visibility="{Binding IsBasic, Converter={StaticResource BoolToVis}}" />
                    <expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" Margin="0,6"
                        Visibility="{Binding IsBasic, Converter={StaticResource BoolToVis}}"
                        ScriptText="{Binding UserName, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="密码:" VerticalAlignment="Center" Margin="0,6"
                               Visibility="{Binding IsBasic, Converter={StaticResource BoolToVis}}" />
                    <expr:ExpressionTextBox Grid.Row="5" Grid.Column="1" Margin="0,6"
                        Visibility="{Binding IsBasic, Converter={StaticResource BoolToVis}}"
                        ScriptText="{Binding Password, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Token:" VerticalAlignment="Center" Margin="0,6"
                               Visibility="{Binding IsToken, Converter={StaticResource BoolToVis}}" />
                    <expr:ExpressionTextBox Grid.Row="6" Grid.Column="1" Margin="0,6"
                        Visibility="{Binding IsToken, Converter={StaticResource BoolToVis}}"
                        ScriptText="{Binding Token, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="证书路径:" VerticalAlignment="Center" Margin="0,6"
                               Visibility="{Binding IsCertificate, Converter={StaticResource BoolToVis}}" />
                    <expr:ExpressionTextBox Grid.Row="7" Grid.Column="1" Margin="0,6"
                        Visibility="{Binding IsCertificate, Converter={StaticResource BoolToVis}}"
                        ScriptText="{Binding ClientCertPath, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="证书密码:" VerticalAlignment="Center" Margin="0,6"
                               Visibility="{Binding IsCertificate, Converter={StaticResource BoolToVis}}" />
                    <expr:ExpressionTextBox Grid.Row="8" Grid.Column="1" Margin="0,6"
                        Visibility="{Binding IsCertificate, Converter={StaticResource BoolToVis}}"
                        ScriptText="{Binding ClientCertPassword, Mode=TwoWay}" ExpectedResultType="String"
                        SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="忽略证书错误（不安全）:" VerticalAlignment="Center" Margin="0,6" />
                    <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,6" VerticalAlignment="Center"
                              IsChecked="{Binding IgnoreServerCertificateErrors}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="同名时替换:" VerticalAlignment="Center" Margin="0,6" />
                    <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,6" VerticalAlignment="Center"
                              IsChecked="{Binding ReplaceIfExists}" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="兼容模式（关闭连接）:" VerticalAlignment="Center" Margin="0,6" />
                    <CheckBox Grid.Row="11" Grid.Column="1" Margin="0,6" IsChecked="{Binding ForceConnectionClose}"
                              ToolTip="默认开启以兼容无长度报文的设备；标准 HTTP 服务可关闭以复用连接。忽略证书错误仅限测试环境。" />
                    <TextBlock Grid.Row="12" Grid.Column="0" Text="默认请求头:" VerticalAlignment="Top" Margin="0,10" />
                    <DataGrid Grid.Row="12" Grid.Column="1" Margin="0,6" Height="160"
                              ItemsSource="{Binding DefaultHeaders}" AutoGenerateColumns="False" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="Value (表达式)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <expr:ExpressionTextBox ScriptText="{Binding Value, Mode=TwoWay}" ExpectedResultType="String"
                                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
