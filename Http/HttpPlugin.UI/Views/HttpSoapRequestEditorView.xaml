<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			 xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			 xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
			 syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
			 d:DesignHeight="520" d:DesignWidth="800"
			 x:Class="Http.UI.Views.HttpSoapRequestEditorView">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</UserControl.Resources>
	<syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
		<syncfusion:TabItemExt Header="Http SoapRequest"
							   Image="pack://application:,,,/Http.StepPlugin.UI;component/Resources/Icons/http.png"
							   ImageHeight="20" ImageWidth="20">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<Grid Margin="16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="160" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" Text="客户端名称:" VerticalAlignment="Center" Margin="0,6" />
					<expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
						ScriptText="{Binding ClientName, Mode=TwoWay}"
						SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
						EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
					<TextBlock Grid.Row="1" Grid.Column="0" Text="服务路径:" VerticalAlignment="Center" Margin="0,6" />
					<expr:ExpressionTextBox Grid.Row="1" Grid.Column="1" Margin="0,6"
						ScriptText="{Binding Path, Mode=TwoWay}"
						SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
						EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
					<TextBlock Grid.Row="2" Grid.Column="0" Text="SOAP 版本:" VerticalAlignment="Center" Margin="0,6" />
					<ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							  ItemsSource="{Binding SoapVersions}" SelectedItem="{Binding SoapVersion, Mode=TwoWay}" />
					<TextBlock Grid.Row="3" Grid.Column="0" Text="SOAPAction:" VerticalAlignment="Center" Margin="0,6" />
					<expr:ExpressionTextBox Grid.Row="3" Grid.Column="1" Margin="0,6"
						ScriptText="{Binding SoapAction, Mode=TwoWay}"
						SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
						EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
					<TextBlock Grid.Row="4" Grid.Column="0" Text="Envelope:" VerticalAlignment="Center" Margin="0,6" />
					<expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" Margin="0,6" MinHeight="120"
						ScriptText="{Binding Envelope, Mode=TwoWay}"
						SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
						EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
					<TextBlock Grid.Row="5" Grid.Column="0" Text="响应变量:" VerticalAlignment="Center" Margin="0,6" />
					<TextBox Grid.Row="5" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							 Text="{Binding ResponseVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="6" Grid.Column="0" Text="状态码变量:" VerticalAlignment="Center" Margin="0,6" />
					<TextBox Grid.Row="6" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							 Text="{Binding StatusCodeVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="7" Grid.Column="0" Text="Fault判失败:" VerticalAlignment="Center" Margin="0,6" />
					<CheckBox Grid.Row="7" Grid.Column="1" Margin="0,6" VerticalAlignment="Center"
							  IsChecked="{Binding TreatSoapFaultAsFailure}" />
					<TextBlock Grid.Row="8" Grid.Column="0" Text="请求头:" VerticalAlignment="Top" Margin="0,10" />
					<DataGrid Grid.Row="8" Grid.Column="1" Margin="0,6" Height="140"
							  ItemsSource="{Binding Headers}" AutoGenerateColumns="False" CanUserAddRows="True">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
							<DataGridTextColumn Header="Value (表达式)" Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
						</DataGrid.Columns>
					</DataGrid>
                </Grid>
			</ScrollViewer>
		</syncfusion:TabItemExt>
	</syncfusion:TabControlExt>
</UserControl>