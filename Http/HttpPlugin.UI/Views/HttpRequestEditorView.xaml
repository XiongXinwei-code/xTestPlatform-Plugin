<UserControl xmlns:vardrop="clr-namespace:PluginCommon.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			 xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			 xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
			 syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
			 d:DesignHeight="520" d:DesignWidth="800"
			 x:Class="Http.UI.Views.HttpRequestEditorView">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</UserControl.Resources>
	<syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
		<syncfusion:TabItemExt Header="Http Request"
							   Image="pack://application:,,,/Http.StepPlugin.UI;component/Resources/Icons/http_request.png"
							   ImageHeight="20" ImageWidth="20">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<Grid Margin="16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="160" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" Text="客户端名称:" VerticalAlignment="Center" Margin="0,6" />
					<expr:ExpressionTextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
                        ScriptText="{Binding ClientName, Mode=TwoWay}" ExpectedResultType="String"
						SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
						EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
					<TextBlock Grid.Row="1" Grid.Column="0" Text="请求方法:" VerticalAlignment="Center" Margin="0,6" />
					<ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							  ItemsSource="{Binding Methods}" SelectedItem="{Binding Method, Mode=TwoWay}" />
					<TextBlock Grid.Row="2" Grid.Column="0" Text="请求路径:" VerticalAlignment="Center" Margin="0,6" />
					<expr:ExpressionTextBox Grid.Row="2" Grid.Column="1" Margin="0,6"
                        ScriptText="{Binding Path, Mode=TwoWay}" ExpectedResultType="String"
						SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
						EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
					<TextBlock Grid.Row="3" Grid.Column="0" Text="请求体类型:" VerticalAlignment="Center" Margin="0,6" />
					<ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							  ItemsSource="{Binding ContentTypes}" SelectedItem="{Binding ContentType, Mode=TwoWay}" />
					<TextBlock Grid.Row="4" Grid.Column="0" Text="请求体:" VerticalAlignment="Center" Margin="0,6"
							   Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />
					<expr:ExpressionTextBox Grid.Row="4" Grid.Column="1" Margin="0,6" MinHeight="80"
						Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}"
                        ScriptText="{Binding Body, Mode=TwoWay}" ExpectedResultType="String" ToolTip="{Binding BodyHint}"
						SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
						EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
					<TextBlock Grid.Row="5" Grid.Column="0" Text="响应变量:" VerticalAlignment="Center" Margin="0,6" />
					<TextBox vardrop:VariableDrop.Target="True" Grid.Row="5" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							 Text="{Binding ResponseVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="6" Grid.Column="0" Text="状态码变量:" VerticalAlignment="Center" Margin="0,6" />
					<TextBox vardrop:VariableDrop.Target="True" Grid.Row="6" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							 Text="{Binding StatusCodeVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="7" Grid.Column="0" Text="耗时变量:" VerticalAlignment="Center" Margin="0,6" />
					<TextBox vardrop:VariableDrop.Target="True" Grid.Row="7" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"
							 Text="{Binding ElapsedVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="8" Grid.Column="0" Text="非2xx返回执行错误:" VerticalAlignment="Center" Margin="0,6" />
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding TreatNonSuccessAsFailure}" />
                        <CheckBox Margin="20,0,0,0" Content="输出脱敏通信摘要" IsChecked="{Binding LogPayload}"
                                  ToolTip="仅记录目标主机、方法、状态码及长度，不记录正文或路径参数。" />
                    </StackPanel>
					<TextBlock Grid.Row="9" Grid.Column="0" Text="请求头:" VerticalAlignment="Top" Margin="0,10" />
					<DataGrid Grid.Row="9" Grid.Column="1" Margin="0,6" Height="140"
							  ItemsSource="{Binding Headers}" AutoGenerateColumns="False" CanUserAddRows="True">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="Value (表达式)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <expr:ExpressionTextBox ScriptText="{Binding Value, Mode=TwoWay}" ExpectedResultType="String"
                                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
                </Grid>
			</ScrollViewer>
		</syncfusion:TabItemExt>
        <syncfusion:TabItemExt Header="Response / Limits">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="响应正文格式" Margin="0,6" />
                    <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding ResponseFormats}" SelectedItem="{Binding ResponseFormat, Mode=TwoWay}" />
                    <TextBlock Text="{Binding ResponseHint}" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <TextBlock Text="响应头 JSON 输出变量（可选）" Margin="0,6" />
                    <TextBox vardrop:VariableDrop.Target="True" Text="{Binding ResponseHeadersVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="JSON 对象：每个响应头名称对应一个字符串数组，包含内容头和接收完成后的尾部头。可能包含 Cookie 等敏感值，请仅映射到所需变量。" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <TextBlock Text="本次请求期限 (ms)" Margin="0,6" />
                    <TextBox Width="240" HorizontalAlignment="Left" Text="{Binding TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    <TextBlock Text="0 沿用客户端期限；正值与客户端期限取较小者。只影响本次请求，不修改共享客户端。覆盖发送、等待响应及完整正文读取。" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <TextBlock Text="响应正文最大字节数" Margin="0,6" />
                    <TextBox Width="240" HorizontalAlignment="Left" Text="{Binding MaxResponseBytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    <TextBlock Text="默认 16777216（16 MiB），必须大于 0。超出返回 Error，不发布截断正文或本次输出；Hex / Base64 的编码长度不计入此上限。" TextWrapping="Wrap" Margin="0,6" />
                </StackPanel>
            </ScrollViewer>
        </syncfusion:TabItemExt>
	</syncfusion:TabControlExt>
</UserControl>
