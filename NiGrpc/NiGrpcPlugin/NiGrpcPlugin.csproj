<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.5</Version>
    <Description>通过 NI gRPC Device Server 调用 DAQmx 和 XNET 的步骤插件</Description>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NiGrpc.StepPlugin</AssemblyName>
    <RootNamespace>NiGrpc</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xTestPlatform.StepEditor.SDK" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../Protos/session.proto" ProtoRoot="../Protos" GrpcServices="None" />
    <Protobuf Include="../Protos/data_moniker.proto" ProtoRoot="../Protos" GrpcServices="None" />
    <Protobuf Include="../Protos/ni/protobuf/types/precision_timestamp.proto" ProtoRoot="../Protos" GrpcServices="None" />
    <Protobuf Include="../Protos/ni/protobuf/types/waveform.proto" ProtoRoot="../Protos" GrpcServices="None" />
    <Protobuf Include="../Protos/nidaqmx.proto" ProtoRoot="../Protos" GrpcServices="Client" />
    <Protobuf Include="../Protos/nixnet.proto" ProtoRoot="../Protos" GrpcServices="Client" />
  </ItemGroup>
</Project>
