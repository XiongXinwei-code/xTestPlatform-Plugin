<UserControl x:Class="ZlgEtherCat.UI.Views.ConfigureBoardPulseEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
    xmlns:common="clr-namespace:PluginCommon.UI" common:PluginEditorScrolling.Enabled="True">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="配置板载脉冲" Image="pack://application:,,,/ZlgEtherCat.StepPlugin.UI;component/Resources/Icons/zlg_configureboardpulse.png" ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding OperationTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding OperationHelp}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding ConnectionNameVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ConnectionNameLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="ConnectionNameEditor" ScriptText="{Binding ConnectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding ConnectionNameInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding PortVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding PortLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="PortEditor"  Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding PortInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding PulseModeVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding PulseModeLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <ComboBox x:Name="PulseModeEditor" ItemsSource="{Binding PulseModeChoices}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding PulseMode, Mode=TwoWay}" />
                        <TextBlock Text="{Binding PulseModeInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding FrequencyHzVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding FrequencyHzLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="FrequencyHzEditor"  Text="{Binding FrequencyHzText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding FrequencyHzInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding DirectionVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding DirectionLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="DirectionEditor"  Text="{Binding DirectionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding DirectionInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding DutyVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding DutyLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="DutyEditor"  Text="{Binding DutyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding DutyInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ContinuousVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ContinuousLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <CheckBox x:Name="ContinuousEditor" IsChecked="{Binding Continuous, Mode=TwoWay}" Content="{Binding ContinuousLabel}" />
                        <TextBlock Text="{Binding ContinuousInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding TimeoutMsVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TimeoutMsLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="TimeoutMsEditor"  Text="{Binding TimeoutMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding TimeoutMsInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ResultVariableVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ResultVariableLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="ResultVariableEditor" common:VariableDrop.Target="True" Text="{Binding ResultVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding ResultVariableInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
