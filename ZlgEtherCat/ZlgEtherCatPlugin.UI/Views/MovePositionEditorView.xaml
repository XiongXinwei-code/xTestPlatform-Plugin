<UserControl x:Class="ZlgEtherCat.UI.Views.MovePositionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
    xmlns:common="clr-namespace:PluginCommon.UI" common:PluginEditorScrolling.Enabled="True">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="位置运动" Image="pack://application:,,,/ZlgEtherCat.StepPlugin.UI;component/Resources/Icons/zlg_moveposition.png" ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding OperationTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding OperationHelp}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding ConnectionNameVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ConnectionNameLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="ConnectionNameEditor" ScriptText="{Binding ConnectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding ConnectionNameInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding AxisNameVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding AxisNameLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="AxisNameEditor" ScriptText="{Binding AxisName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding AxisNameInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding PositionVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding PositionLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="PositionEditor" ScriptText="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding PositionInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding RelativeVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding RelativeLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <CheckBox x:Name="RelativeEditor" IsChecked="{Binding Relative, Mode=TwoWay}" Content="{Binding RelativeLabel}" />
                        <TextBlock Text="{Binding RelativeInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ProfileVelocityVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ProfileVelocityLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="ProfileVelocityEditor" ScriptText="{Binding ProfileVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding ProfileVelocityInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding AccelerationVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding AccelerationLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="AccelerationEditor" ScriptText="{Binding Acceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding AccelerationInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding DecelerationVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding DecelerationLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="DecelerationEditor" ScriptText="{Binding Deceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding DecelerationInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding TimeoutMsVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TimeoutMsLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="TimeoutMsEditor"  Text="{Binding TimeoutMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding TimeoutMsInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ResultVariableVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ResultVariableLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="ResultVariableEditor" common:VariableDrop.Target="True" Text="{Binding ResultVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding ResultVariableInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
