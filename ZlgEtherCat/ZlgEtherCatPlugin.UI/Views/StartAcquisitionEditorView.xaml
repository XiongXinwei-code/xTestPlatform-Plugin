<UserControl x:Class="ZlgEtherCat.UI.Views.StartAcquisitionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:expr="clr-namespace:ExpressionTextBox;assembly=ExpressionTextBox"
    xmlns:common="clr-namespace:PluginCommon.UI" common:PluginEditorScrolling.Enabled="True">
    <syncfusion:TabControlExt CloseButtonType="Hide" AllowDragDrop="False" EnableLabelEdit="False">
        <syncfusion:TabItemExt Header="启动 PDO 后台采集" Image="pack://application:,,,/ZlgEtherCat.StepPlugin.UI;component/Resources/Icons/zlg_startacquisition.png" ImageHeight="20" ImageWidth="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding OperationTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding OperationHelp}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding ConnectionNameVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ConnectionNameLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <expr:ExpressionTextBox x:Name="ConnectionNameEditor" ScriptText="{Binding ConnectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ExpectedResultType="String"
                            SequenceFile="{Binding SequenceFile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            EditPosition="{Binding EditPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding ConnectionNameInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding NativeWaitMsVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding NativeWaitMsLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="NativeWaitMsEditor"  Text="{Binding NativeWaitMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding NativeWaitMsInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding HistoryCapacityVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding HistoryCapacityLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="HistoryCapacityEditor"  Text="{Binding HistoryCapacityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding HistoryCapacityInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding LatestOnlyVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding LatestOnlyLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <CheckBox x:Name="LatestOnlyEditor" IsChecked="{Binding LatestOnly, Mode=TwoWay}" Content="{Binding LatestOnlyLabel}" />
                        <TextBlock Text="{Binding LatestOnlyInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding AcquisitionThreadPriorityVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding AcquisitionThreadPriorityLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <ComboBox x:Name="AcquisitionThreadPriorityEditor" ItemsSource="{Binding AcquisitionThreadPriorityChoices}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding AcquisitionThreadPriority, Mode=TwoWay}" />
                        <TextBlock Text="{Binding AcquisitionThreadPriorityInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding RxHighWatermarkPercentVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding RxHighWatermarkPercentLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="RxHighWatermarkPercentEditor"  Text="{Binding RxHighWatermarkPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding RxHighWatermarkPercentInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding RxBacklogWarningMsVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding RxBacklogWarningMsLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="RxBacklogWarningMsEditor"  Text="{Binding RxBacklogWarningMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding RxBacklogWarningMsInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding RxAlarmRepeatMsVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding RxAlarmRepeatMsLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="RxAlarmRepeatMsEditor"  Text="{Binding RxAlarmRepeatMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding RxAlarmRepeatMsInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding TimeoutMsVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TimeoutMsLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="TimeoutMsEditor"  Text="{Binding TimeoutMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding TimeoutMsInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ResultVariableVisibility}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ResultVariableLabel}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox x:Name="ResultVariableEditor" common:VariableDrop.Target="True" Text="{Binding ResultVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <TextBlock Text="{Binding ResultVariableInfo}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
