<UserControl x:Class="LabVIEWCallPlugin.UI.Views.LabVIEWCallEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvadp="clr-namespace:LabVIEWCallPlugin.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="800"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="5"
                                      ShadowDepth="2"
                                      Opacity="0.3"
                                      Direction="315"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="10"
                                              ShadowDepth="3"
                                              Opacity="0.5"
                                              Direction="315"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <syncfusion:TabControlExt CloseButtonType="Hide"
                              AllowDragDrop="False"
                              EnableLabelEdit="False">

        <syncfusion:TabItemExt Header="LabVIEWCall"
                               Image="pack://application:,,,/LabVIEWCall.StepPlugin.UI;component/Resources/Icons/labview.png"
                               ImageHeight="20" ImageWidth="20">
            <ScrollViewer x:Name="EditorScroll" Margin="12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="EditorContent" MinHeight="440" Height="{Binding ViewportHeight, ElementName=EditorScroll}" SizeChanged="EditorContent_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: VI 路径输入栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <syncfusion:SfTextBoxExt x:Name="ViPathTextBox"
                     Margin="0,0,10,0"
                     Watermark="VI Path..."
                     Text="{Binding Setting.ViFilePath, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     Focusable="False"
                     IsTabStop="False"

                     Background="{DynamicResource ContentBackgroundAlt1}"
                     Cursor="Arrow"/>

            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="选择VI文件..."
                    Margin="0,0,5,0"
                    Click="BrowseButton_Click">
                <materialDesign:PackIcon Kind="OpenInBrowser" Width="16" Height="16"/>
            </Button>

            <Button x:Name="EditButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="编辑VI文件..."
                    Margin="0,0,5,0"
                    Click="EditButton_Click">
                <materialDesign:PackIcon Kind="EditBox" Width="16" Height="16"/>
            </Button>

            <Button x:Name="ReLoadButton"
                    Grid.Column="3"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="刷新VI文件..."
                    Margin="0,0,5,0"
                    Click="ReLoadButton_Click">
                <materialDesign:PackIcon Kind="Reload" Width="16" Height="16"/>
            </Button>
        </Grid>

        <!-- Row 1: Show / Close 复选框 -->
        <StackPanel Grid.Row="1">
        <TextBlock Text="需要安装并打开能运行此 VI 的 LabVIEW 开发环境，并启用 TCP/IP VI Server；仅支持 .vi。" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,8">
            <CheckBox Content="Show VI front panel"
                      IsChecked="{Binding Setting.ShowPanel, ElementName=Root, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,15,8"/>
            <CheckBox Content="Close front panel after call"
                      IsChecked="{Binding Setting.ClosePanel, ElementName=Root, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,15,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,15,8">
            <TextBlock Text="Timeout (ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="90" VerticalAlignment="Center"
                     Text="{Binding Setting.TimeoutMs, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="VI 执行超时时间（毫秒），0 表示不限制"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,15,8">
                <TextBlock Text="VI Server port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ViServerPortTextBox" Width="90" VerticalAlignment="Center"
                         Text="{Binding Setting.ViServerPort, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                         ToolTip="本机 127.0.0.1 的 LabVIEW VI Server TCP 端口；1 至 65535，默认 3363。"/>
            </StackPanel>
            <Button Content="清除不支持的端子日志标记" Margin="12,0,0,0"
                    Visibility="{Binding ViewModel.HasUnsupportedLogs, ElementName=LvPanel, Converter={StaticResource BooleanVisibility}}"
                    Command="{Binding ViewModel.ClearUnsupportedLogsCommand, ElementName=LvPanel}"/>
        </WrapPanel>
        </StackPanel>

        <!-- Row 2: LvPanelView 参数面板 -->
        <TextBlock x:Name="Feedback" Grid.Row="2" TextWrapping="Wrap" Margin="10,0,10,5" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        <lvadp:LvPanelView x:Name="LvPanel"
                           Grid.Row="3"
                           SequenceFile="{Binding SequenceFile, ElementName=Root}"
                           EditPosition="{Binding EditPosition, ElementName=Root}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>
            </Grid>
            </ScrollViewer>
        </syncfusion:TabItemExt>
    </syncfusion:TabControlExt>
</UserControl>
